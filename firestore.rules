rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /calls/{callId} {
      allow read, write: if true;
      match /{subcollection}/{docId} {
        allow read, write: if true;
      }
    }
    match /devices/{deviceId} {
      allow read, write: if true;
      // Les règles Firestore ne descendent PAS dans les sous-collections : sans
      // cette seconde règle, la publication des journées d'usage (voir
      // DeviceStatusReporter.publishUsage) serait refusée en silence, et le
      // panneau d'administration afficherait une semaine vide sans que rien
      // n'indique pourquoi.
      match /usage/{day} {
        allow read, write: if true;
      }
    }
  }
}
