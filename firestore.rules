rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /calls/{callId} {
      allow read, write: if true;
      match /{subcollection}/{docId} {
        allow read, write: if true;
      }
    }
    match /devices/{deviceId} {
      allow read, write: if true;
      // Les règles Firestore ne descendent PAS dans les sous-collections : sans
      // cette seconde règle, la publication des journées d'usage (voir
      // DeviceStatusReporter.publishUsage) serait refusée en silence, et le
      // panneau d'administration afficherait une semaine vide sans que rien
      // n'indique pourquoi.
      match /usage/{day} {
        allow read, write: if true;
      }
      // La trace de reconnaissance, et ses morceaux un niveau plus bas. Deux
      // règles là encore, pour la même raison : sans la seconde, les morceaux
      // seraient refusés en silence et le panneau afficherait un index de
      // trace dont aucun contenu n'arriverait jamais.
      //
      // Ce que ces documents contiennent est CHIFFRÉ (voir TranscriptionTrace)
      // — et il le faut, parce que ces règles-ci laissent lire n'importe qui,
      // alors qu'une trace de reconnaissance est un transcript de la chambre
      // de Jean.
      // Le journal technique de la visiophonie. Une règle de plus pour la
      // même raison que les deux au-dessus : les règles ne descendent pas
      // toutes seules.
      //
      // Celui-ci est EN CLAIR, et c'est délibéré : il ne contient aucune
      // donnée personnelle (voir CallTrace — la garantie tient à ce que le
      // chemin de la transcription n'y écrit jamais, pas à une consigne). Ce
      // qu'il contient pourrait être affiché sur la porte de la chambre.
      match /diag/{name} {
        allow read, write: if true;
      }
      match /traces/{traceId} {
        allow read, write: if true;
        match /chunks/{index} {
          allow read, write: if true;
        }
      }
    }
  }
}
