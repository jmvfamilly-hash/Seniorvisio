rules_version = '2';

// Règles d'accès aux fichiers des recueils (voir docs/architecture-recueils.md).
//
// ═══ CE FICHIER N'EST PAS DÉPLOYÉ AUTOMATIQUEMENT ═══
//
// Contrairement à firestore.rules, il ne part pas à chaque push : il attend
// un déclenchement manuel (voir .github/workflows/deploy-storage-rules.yml).
// C'est délibéré. Publier ces règles, c'est ouvrir un espace où vont vivre
// des photos de famille, et cette décision revient à l'administrateur du
// projet, pas au commit qui écrit le code.
//
// Tant qu'elles ne sont pas déployées, Firebase Storage refuse tout, et
// l'étape 2 ne fonctionne pas. C'est le comportement voulu : un interrupteur
// que quelqu'un doit consciemment actionner.
//
// ═══ CE QU'ELLES PROTÈGENT, ET CE QU'ELLES NE PROTÈGENT PAS ═══
//
// Elles PROTÈGENT contre : l'écriture hors des chemins prévus, les fichiers
// démesurés qui rempliraient le quota, et les types qui n'ont rien à faire là
// — un exécutable déposé sous couvert de photo.
//
// Elles NE PROTÈGENT PAS contre quelqu'un qui connaît l'adresse du site. Le
// PWA n'a aucune authentification : chaque proche appelle depuis son propre
// téléphone, sans compte à créer, et c'est un choix d'ergonomie assumé depuis
// le début du projet. Exiger `request.auth != null` rendrait simplement le
// téléversement impossible.
//
// La vraie protection à ce stade tient à ce que les noms de chemins ne sont
// pas devinables — c'est mince, et il faut le savoir plutôt que de le croire
// résolu. Le jour où ça ne suffira plus, la marche à suivre est l'inscription
// anonyme Firebase, qui ne demande rien au proche et permet de restreindre à
// « quelqu'un qui est passé par le site ».

service firebase.storage {
  match /b/{bucket}/o {

    // Les éléments des recueils, rangés par appareil puis par recueil :
    //   recueils/{appareil}/{recueilId}/{elementId}
    //
    // Le premier segment est l'appareil (jean_tablet ou test_tablet) : la
    // séparation production / banc d'essai vaut ici comme partout ailleurs.
    match /recueils/{appareil}/{recueilId}/{elementId} {

      // Lecture ouverte : c'est la tablette qui télécharge, et elle n'a pas
      // d'identité Firebase — elle fait une simple requête HTTPS avec le
      // jeton contenu dans l'URL (voir RecueilStore, et le choix de ne pas
      // embarquer le SDK Storage).
      allow read: if true;

      // Dépôt borné. Ces deux limites ne sont pas cosmétiques :
      //
      //   - 25 Mo couvre une photo d'appareil moderne et une courte vidéo,
      //     et ferme la porte à un dépôt qui viderait le quota du projet ;
      //   - le type doit être une image ou une vidéo. La tablette vérifiera
      //     de toute façon en décodant pour de bon (voir VerificateurElement)
      //     — mais autant ne pas payer le téléchargement d'un fichier dont on
      //     sait déjà qu'il sera refusé.
      //
      // ═══ POURQUOI create/update ET NON write ═══
      //
      // `write` couvre AUSSI la suppression. Or sur une suppression il n'y a
      // pas de fichier entrant : `request.resource` vaut null, la condition
      // ci-dessous déréférence null, la règle échoue — et une règle qui
      // échoue refuse.
      //
      // Conséquence mesurée, pas supposée : un dépôt renvoyait HTTP 200 et la
      // suppression du même objet HTTP 403. Le bouton « Retirer » d'un recueil
      // n'aurait jamais effacé les fichiers, et ils se seraient accumulés sans
      // que rien ne le signale — recueils.js ne fait d'ailleurs qu'avertir
      // dans la console, délibérément, pour qu'un fichier orphelin n'empêche
      // pas le recueil de disparaître de l'écran.
      allow create, update: if request.resource.size < 25 * 1024 * 1024
                            && (request.resource.contentType.matches('image/.*')
                                || request.resource.contentType.matches('video/.*'));

      // Suppression permise sans condition, faute de pouvoir en poser une qui
      // ait un sens : sans authentification, ces règles ne distinguent pas
      // celui qui a déposé le fichier de n'importe qui d'autre. Le refuser
      // n'apporterait aucune sécurité — qui peut supprimer peut déjà écraser
      // par-dessus — et coûterait l'accumulation sans fin de fichiers dont
      // plus aucun recueil ne parle.
      allow delete: if true;
    }

    // Les clips fond vert déposés depuis le panneau admin du PWA, en
    // attente de détourage (voir scripts/traiter_vignette.sh et
    // web-caller/vignettes.js) :
    //   vignettes_brutes/{sceneId}/clip.<extension>
    //
    // Pas de séparation par appareil ici, contrairement à /recueils : une
    // scène traitée est la même pour CHAQUE tablette, qui la télécharge et
    // la vérifie elle-même une fois publiée (voir /vignettes_pretes
    // ci-dessous et VignetteStore côté application) — elle n'appartient à
    // aucun appareil en particulier.
    match /vignettes_brutes/{sceneId}/{fichier} {
      // Lecture ouverte : c'est le poste de traitement (hors tablette, voir
      // le script) qui télécharge le clip d'origine, sans jeton ni identité
      // Firebase, comme pour /recueils.
      allow read: if true;

      // 60 Mo : un clip de quelques secondes en pleine définition tient
      // largement en dessous (les clips déjà traités avoisinent plutôt
      // quelques mégaoctets), la limite ferme seulement la porte à un dépôt
      // qui viderait le quota du projet. `create, update` et non `write`,
      // pour la même raison que /recueils : `write` couvre aussi la
      // suppression, où `request.resource` vaut null et ferait échouer la
      // règle.
      allow create, update: if request.resource.size < 60 * 1024 * 1024
                            && request.resource.contentType.matches('video/.*');

      // Pas de condition possible sans authentification, comme pour
      // /recueils — voir le commentaire en tête de ce fichier.
      allow delete: if true;
    }

    // L'archive d'une scène déjà traitée (détourée), telle que publiée par
    // scripts/publier_vignette.sh :
    //   vignettes_pretes/{sceneId}/cadres.zip
    //
    // C'est ce chemin que VignetteStore télécharge sur la tablette — jamais
    // /vignettes_brutes, qui ne contient qu'un clip fond vert encore à
    // traiter. Même absence de séparation par appareil que ci-dessus.
    match /vignettes_pretes/{sceneId}/{fichier} {
      // Lecture ouverte : c'est VignetteStore, côté tablette, qui télécharge
      // sans jeton ni identité Firebase, comme pour /recueils.
      allow read: if true;

      // 30 Mo : cent images WebP à la définition d'affichage réelle (voir
      // scripts/traiter_vignette.sh) tiennent largement en dessous ; la
      // limite ferme seulement la porte à un dépôt qui viderait le quota du
      // projet. Pas de contrainte de type MIME ici — contrairement à
      // /vignettes_brutes, ce chemin n'est jamais alimenté depuis le PWA.
      allow create, update: if request.resource.size < 30 * 1024 * 1024;

      // Pas de condition possible sans authentification, comme pour
      // /recueils — voir le commentaire en tête de ce fichier.
      allow delete: if true;
    }

    // Tout le reste est refusé. Écrit explicitement plutôt que laissé au
    // défaut : une règle absente et une règle qui refuse se comportent
    // pareil, mais seule la seconde dit qu'on y a pensé.
    match /{chemin=**} {
      allow read, write: if false;
    }
  }
}
