<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Depuis Android 11, une application ne voit pas les services des autres
         sans les déclarer : sans cette ligne, isRecognitionAvailable rend faux
         et le moteur reste introuvable, sans erreur ni explication. Le piège a
         déjà coûté un test réel sur l'application principale. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="Papyrus"
        android:supportsRtl="true"
        android:theme="@style/Theme.Papyrus">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="fullSensor"
            android:theme="@style/Theme.Papyrus">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Sortir la trace de la tablette suppose de passer un fichier à une
             autre application. Depuis Android 7, une adresse « file:// » y est
             refusée net : il faut ce fournisseur, qui accorde un accès
             temporaire au seul fichier partagé. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.traces"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
