<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <uses-feature android:name="android.hardware.camera.front" android:required="true" />

    <!-- Depuis Android 11, une application ne voit plus les autres paquets
         installés sans les déclarer ici : sans cette section,
         getLaunchIntentForPackage et getPackageInfo échouent exactement comme
         si l'application était absente, alors qu'elle est bien là (constaté en
         test réel sur la tablette). Déclaration ciblée plutôt que la
         permission QUERY_ALL_PACKAGES, disproportionnée et restreinte par
         Google Play. À compléter pour chaque nouvelle application compagne
         (voir CompanionApps.kt). -->
    <queries>
        <package android:name="com.google.audio.hearing.visualization.accessibility.scribe" />
        <!-- Détecte le ou les navigateurs installés (voir
             AdminSettingsActivity.resolveBrowsers, KioskManager.
             grantTemporaryBrowserAccess) sans connaître leur paquet à l'avance
             — utile pour la connexion initiale au réseau de la résidence
             quand l'écran captif intégré (une simple WebView) ne suffit pas.
             Une déclaration par <intent>, contrairement au navigateur Google
             ci-dessus dont le paquet est connu, couvre n'importe quel
             navigateur déjà présent sur la tablette. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- Nécessaire à la détection/validation d'un portail captif (voir
         WifiConfigurator.checkInternetReachable, AdminSettingsActivity) : le
         reste de l'app (Firestore, FCM, WebRTC) reste entièrement en HTTPS/WSS,
         seule cette vérification opportuniste utilise du HTTP en clair, sans
         quoi le trafic serait bloqué par défaut depuis Android 9. -->
    <application
        android:label="Senior Visio"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/Theme.AppCompat.NoActionBar"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.IncomingCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode" />

        <!-- launchMode singleTask : indispensable pour un écran d'accueil, sinon
             chaque appui sur le bouton Accueil empilerait une nouvelle instance
             au lieu de revenir à celle déjà ouverte. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Senior Visio est le lanceur de la tablette (voir
                 KioskManager.registerAsHomeApp, qui rend le choix définitif sans
                 jamais le demander à Jean). Deux raisons : donner au bouton
                 Accueil un point de chute maîtrisé quand une application
                 compagne est lancée depuis ici, et empêcher la tablette de
                 retomber sur le lanceur Samsung si le mode kiosque lâche. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".admin.AdminSettingsActivity"
            android:exported="false"
            android:label="Réglages (admin)" />

        <!-- Labo d'étude, sans lien avec l'usage normal (voir
             TranscriptionLabActivity.kt) : compare les moteurs de
             transcription vocale disponibles. -->
        <activity
            android:name=".ui.TranscriptionLabActivity"
            android:exported="false"
            android:label="Labo transcription" />

        <service
            android:name=".service.IncomingCallService"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <service
            android:name=".service.CallListenerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Réveil par notification push (voir functions/index.js et
             SeniorVisioMessagingService.kt) : complète l'écoute Firestore
             permanente de CallListenerService, qu'Android peut suspendre une
             fois l'écran éteint depuis un moment (Doze). -->
        <service
            android:name=".service.SeniorVisioMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Provisionnement "Device Owner" (voir KioskManager.kt, DeviceStatusReporter.kt) :
             remplace Headwind, abandonné après un blocage Knox suite à une suppression
             d'appareil sans désenrôlement propre (voir README > Déploiement). -->
        <receiver
            android:name=".admin.SeniorVisioDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".core.UpdateStatusReceiver"
            android:exported="false" />

        <receiver
            android:name=".service.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Envoyé uniquement à cette appli, quand elle vient d'être mise à jour (voir
                     BootReceiver.kt) : sans ça, une mise à jour silencieuse poussée par un MDM
                     (Headwind) tue le processus en cours sans jamais le relancer — le service
                     d'écoute des appels resterait éteint jusqu'à un redémarrage ou une ouverture
                     manuelle de l'appli, et tout appel tenté entre-temps serait raté. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
