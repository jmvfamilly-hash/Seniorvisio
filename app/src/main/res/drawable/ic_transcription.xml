<?xml version="1.0" encoding="utf-8"?>
<!--
     Une bulle de parole qui contient des lignes de texte, pour le bouton
     « Sous-titres ».

     Le dessin doit dire « ce qui se dit va s'écrire », sans un mot de
     vocabulaire technique. Une bulle seule dirait « parler » ; des lignes
     seules diraient « du texte ». C'est leur réunion qui porte le sens, et
     elle se lit sans avoir rien appris.

     Écarté : le sigle « CC » des sous-titres de télévision. Il est
     universellement reconnu par les gens qui savent déjà ce qu'il veut dire,
     et parfaitement opaque pour les autres — or c'est exactement pour les
     autres que cet écran est fait.

     Trois lignes de longueurs inégales, comme un vrai paragraphe : trois
     traits de même longueur ressemblent à un menu, pas à de la parole écrite.

     40dp comme la lune du bouton de sommeil, avec lequel il fait paire aux
     deux coins hauts de l'écran.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="40dp"
    android:height="40dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- La bulle : un rectangle arrondi dont le coin bas-gauche descend en
         pointe. Tracée en contour plutôt qu'en aplat pour que les lignes de
         texte restent lisibles à l'intérieur. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M20,2H4C2.9,2 2,2.9 2,4v11c0,1.1 0.9,2 2,2h2v4.2c0,0.7 0.8,1.1 1.4,0.7L13.6,17H20c1.1,0 2,-0.9 2,-2V4C22,2.9 21.1,2 20,2zM20,15h-6.9l-5.1,3.6V15H4V4h16V15z" />

    <!-- Les trois lignes de texte. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M6,6.5h12v1.6H6z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M6,9.6h12v1.6H6z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M6,12.7h7.5v1.6H6z" />
</vector>
