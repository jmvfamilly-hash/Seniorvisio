<?xml version="1.0" encoding="utf-8"?>
<!--
     Écran d'appel. Du point de vue de Jean ce n'est pas un autre écran que
     l'accueil : ce sont les mêmes trois zones (view_home_zones.xml, voir
     HomeZonesController), posées sur un fond qui change — la vidéo du proche
     à la place du fond uni, puis ses photos s'il lance un diaporama.

     L'ancien bandeau de sous-titres a disparu au profit de la zone 3, qui
     obéit aux mêmes règles que la zone des paroles de la pièce (voir
     PacedCaptionZone) : chaque phrase reste affichée le temps d'être lue, les
     suivantes attendent leur tour.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/callRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remoteRenderer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Photo de l'appelant en plein écran, derrière le nom et le décompte :
         un rond de 160dp était minuscule sur une dalle de dix pouces, alors
         que reconnaître la personne est précisément le but de cet écran. Le
         dégradé sombre par-dessus garde le nom et la barre lisibles quelle que
         soit la photo. Masquée tant qu'aucune photo n'est reçue : le fond du
         FrameLayout (posé selon la palette, voir ScreenTheme) reprend alors le
         dessus. -->
    <ImageView
        android:id="@+id/imageCallerPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Photo de l'appelant"
        android:visibility="gone" />

    <View
        android:id="@+id/callerPhotoScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/caller_photo_scrim"
        android:visibility="gone" />

    <!-- Photo du diaporama commenté à distance par le proche (voir
         WebRtcCallEngine.listenForSlideshowPhoto) : c'est lui qui fait défiler
         les photos depuis le PWA, Jean n'a rien à manipuler.

         Placée après la vidéo (qu'elle recouvre pendant le diaporama) mais
         avant les zones de texte, qui doivent rester lisibles par-dessus —
         c'est justement la combinaison des deux qui fait l'intérêt de la
         fonction : la photo en grand, et ce que raconte le proche écrit
         par-dessus.

         fitCenter et non centerCrop, contrairement à la photo d'appelant :
         une photo de famille recadrée arbitrairement couperait des visages,
         alors qu'ici le but est de regarder l'image en entier. -->
    <ImageView
        android:id="@+id/imageSlideshow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:background="#000000"
        android:contentDescription="Photo partagée par le proche"
        android:visibility="gone" />

    <!-- Élément d'un RECUEIL, que le proche fait défiler pendant l'appel (voir
         LecteurRecueil et CallSignalingClient.listenForRecueilCommande).

         ═══ POURQUOI UNE VUE À PART DU DIAPORAMA CI-DESSUS ═══

         Les deux montrent une photo, mais pas au même endroit : le diaporama
         prend tout l'écran, un recueil prend LA BANDE de la vidéo du proche —
         la même que fitVideoAboveCaptions accorde au visage — pour que la
         transcription reste lisible dessous pendant qu'il commente.

         Une seule vue partagée obligerait à sauvegarder et restaurer sa
         géométrie à chaque bascule. Ce projet a déjà cassé deux fois la mise
         en page de cet écran dans la même journée ; deux vues distinctes, dont
         une seule est visible à la fois, coûtent quelques octets et retirent
         toute une classe d'erreurs.

         La hauteur est posée par le code, comme pour la vidéo. wrap_content en
         largeur avec adjustViewBounds : la vue prend les proportions de la
         photo dans la bande accordée, plutôt que d'étirer. -->
    <ImageView
        android:id="@+id/imageRecueil"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="top|center_horizontal"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:contentDescription="Photo d'un recueil, présentée par le proche"
        android:visibility="gone" />

    <!-- ═══ UN TITRE D'ACTUALITÉ : VIGNETTE À GAUCHE, TEXTE À DROITE ═══

         Occupe la même bande que la vidéo et que les photos d'un recueil, pour
         que la transcription reste lisible dessous.

         La vignette est à poids fixe et le texte prend le reste : c'est le
         texte qui doit être lu, l'image ne fait que l'accompagner. Quand le
         flux ne fournit pas d'illustration — le cas le plus courant —, la
         vignette est masquée et le texte récupère toute la largeur plutôt que
         de se serrer à côté d'un trou (voir IncomingCallActivity).

         autoSizeTextType="uniform" répond à la contrainte « le texte doit
         rentrer dans l'espace qui lui est donné » : Android réduit la taille
         jusqu'à ce que le titre tienne, au lieu de le tronquer. Un titre de
         fil d'information va de quarante à plus de cent trente signes, et
         c'est le long qui déborde. Le plancher de 20 sp n'est pas décoratif :
         en dessous, plus personne ne lit cet écran depuis un fauteuil. -->
    <LinearLayout
        android:id="@+id/blocActualite"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:padding="24dp"
        android:visibility="gone">

        <!-- ═══ LA PHOTO ET SON CRÉDIT, DANS UNE SEULE COLONNE ═══

             L'ImageView occupait cette place seule. Le crédit du photographe
             se rapporte à l'image et non à l'article : il descend donc avec
             elle, et non sous le titre où il passerait pour le nom du fil.

             La photo prend le POIDS, le crédit son contenu. La photo se réduit
             donc exactement de la hauteur du crédit, et la colonne entière
             reste dans la hauteur de la rangée — celle du bloc de titre en
             face. Sans cela, la ligne ajoutée pousserait la colonne au-delà et
             le bas de la photo serait coupé.

             fitCenter et non centerCrop : une photo de presse recadrée perd
             souvent son sujet, et personne ne peut le signaler ici. -->
        <LinearLayout
            android:id="@+id/colonneImageActualite"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:layout_marginEnd="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imageActualite"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="Illustration de l'article" />

            <TextView
                android:id="@+id/creditActualite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:alpha="0.55"
                android:gravity="end"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone"
                android:text="" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="6"
            android:orientation="vertical">

            <TextView
                android:id="@+id/texteActualite"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:textColor="#FFFFFF"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="20sp"
                android:autoSizeMaxTextSize="56sp"
                android:autoSizeStepGranularity="2sp" />

            <!-- ═══ D'OÙ SORT CETTE NOUVELLE ═══

                 Le fil se nomme lui-même dans <channel><title>. Depuis que
                 plusieurs fils cohabitent, c'est une question qu'on se pose en
                 lisant un titre, et à laquelle rien ne répondait.

                 Discrètement, et le mot est à prendre au sérieux : c'est le
                 TITRE que Jean doit lire. Petit corps, transparence réduite,
                 sous le texte. Masqué quand le fil ne se nomme pas, plutôt
                 qu'une mention vide ou un « source inconnue » qui prendrait de
                 la place pour ne rien dire. -->
            <TextView
                android:id="@+id/origineActualite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="16sp"
                android:alpha="0.55"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone"
                android:textColor="#FFFFFF"
                android:text="" />
        </LinearLayout>
    </LinearLayout>

    <!-- Ce que la tablette ne sait pas afficher, ou n'a pas trouvé : dit à
         l'écran plutôt que laissé en noir. Un recueil dont une photo manque ne
         doit pas donner l'impression que l'appel a planté. -->
    <TextView
        android:id="@+id/textRecueilImpossible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:gravity="center"
        android:padding="24dp"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:visibility="gone" />

    <!-- ═══ JEAN NAVIGUE LUI-MÊME ═══

         Jusqu'ici, seul le proche faisait défiler les photos et les titres
         depuis le PWA. Ces deux boutons ouvrent le même chemin à Jean, sans
         rien retirer à l'autre : LecteurRecueil ignore d'où vient la commande,
         c'est la couture prévue pour ça dès l'origine (voir
         docs/architecture-recueils.md, § 5).

         Cela ne contredit pas « Jean n'a jamais rien à faire » : il n'a
         toujours RIEN À FAIRE — l'appel se connecte seul, les photos défilent
         si le proche les fait défiler. Il a maintenant quelque chose qu'il
         PEUT faire, ce qui n'est pas la même chose.

         Visible seulement quand une photo ou un titre est à l'écran (voir
         IncomingCallActivity) : deux boutons qui ne commandent rien invitent à
         les toucher, puis à les croire cassés.

         ═══ L'ESPACEMENT N'EST PAS DE LA MISE EN PAGE ═══

         L'espaceur central porte une largeur minimale et un poids : les deux
         boutons ne peuvent donc jamais se toucher, quels que soient la police
         choisie et la longueur des libellés. Les consignes demandent 16 à
         24 dp de vide entre deux cibles parce que les erreurs de visée sont
         fréquentes — un tremblement suffit à déclencher l'action voisine, et
         ici la voisine est « photo précédente », pas « quitter ». Le vide est
         donc garanti par la structure, pas obtenu par hasard sur une dalle
         large. -->
    <LinearLayout
        android:id="@+id/barreNavigationRecueil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <Button
            android:id="@+id/boutonRecueilPrecedent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Précédente"
            android:textSize="24sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:drawableStart="@drawable/ic_precedent"
            android:drawablePadding="16dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:minHeight="88dp"
            android:minWidth="240dp"
            android:elevation="6dp"
            android:background="@drawable/fond_bouton_navigation" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:minWidth="24dp" />

        <Button
            android:id="@+id/boutonRecueilSuivant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Suivante"
            android:textSize="24sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:drawableEnd="@drawable/ic_suivant"
            android:drawablePadding="16dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:minHeight="88dp"
            android:minWidth="240dp"
            android:elevation="6dp"
            android:background="@drawable/fond_bouton_navigation" />
    </LinearLayout>

    <!-- Nom de l'appelant et décompte, le temps de la sonnerie uniquement :
         masqué dès la connexion. Le repère date/moment/météo qui vivait ici
         en double a disparu — c'est la zone 1, présente en permanence
         par-dessus, qui s'en charge maintenant pour les deux écrans. -->
    <LinearLayout
        android:id="@+id/alertContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <!-- Aucune couleur fixée sur ces trois éléments : elles suivent la
             palette du moment (voir IncomingCallActivity, onPalette). Écrites
             en dur, elles dataient du fond bleu foncé permanent — sur la
             palette claire du jour, l'écran de sonnerie devenait du blanc sur
             blanc, sans nom d'appelant ni barre d'attente visibles. -->
        <TextView
            android:id="@+id/textCallerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Appel de..."
            android:textSize="48sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Décompte : la barre qui se remplit doucement porte l'essentiel de
             l'information visuelle, le chiffre reste discret en dessous
             (recommandation ergonomique : éviter l'effet de compte à rebours
             anxiogène d'un gros chiffre qui défile). -->
        <FrameLayout
            android:id="@+id/countdownProgressContainer"
            android:layout_width="280dp"
            android:layout_height="10dp"
            android:layout_marginTop="28dp">

            <View
                android:id="@+id/countdownProgressFill"
                android:layout_width="280dp"
                android:layout_height="10dp"
                android:background="#2ECC71" />
        </FrameLayout>

        <TextView
            android:id="@+id/textCountdownHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="La visio démarre automatiquement"
            android:textSize="18sp"
            android:gravity="center" />

    </LinearLayout>

    <!-- Les trois zones, identiques à celles de l'écran d'accueil. -->
    <include layout="@layout/view_home_zones" />

    <!-- Miniature de Jean, au-dessus des zones : c'est un tout petit élément
         qu'un cadre de texte recouvrirait entièrement. Masquée par défaut,
         affichée seulement si le proche l'active depuis le PWA. -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/localRenderer"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:visibility="gone" />

    <!-- Version affichée en permanence, discrètement, pour vérifier à distance
         quel APK tourne réellement sur la tablette (voir BuildConfig.BUILD_REV). -->
    <TextView
        android:id="@+id/textBuildRev"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:textColor="#4DFFFFFF"
        android:textSize="11sp"
        android:text="" />

    <!-- Répondre sans attendre la fin du décompte.
         Pour qui se trouve déjà dans la pièce — un proche en visite, quelqu'un
         qui passe — et n'a aucune raison de regarder une barre se remplir
         pendant trente secondes alors que la conversation peut commencer tout
         de suite. Jean, lui, n'a toujours rien à faire : sans personne pour y
         toucher, le décompte va au bout et l'appel se connecte seul, exactement
         comme avant.
         Disparaît dès la connexion (voir connectVideoCall) : il n'a plus de
         sens une fois l'appel établi, et deux boutons côte à côte pendant la
         conversation invitent à en toucher un par erreur. -->
    <!-- ═══ REFAIT SELON LES CONSIGNES D'ACCESSIBILITÉ ═══

         Quatre exigences tenaient sur ce seul bouton, et il en manquait trois.

         1. PAS DE CAPITALES. Le thème de cette application est
            Theme.AppCompat, dont Widget.AppCompat.Button impose
            textAllCaps : ce bouton affichait « RÉPONDRE MAINTENANT ». Or le
            cerveau reconnaît un mot à sa silhouette globale ; en capitales,
            tous les mots deviennent des blocs rectangulaires de même hauteur,
            et il faut les déchiffrer lettre par lettre. C'est coûteux pour
            tout le monde et davantage en cas de trouble cognitif.
            Posé en XML ici ET dans le code (voir MiseEnFormeSenior) : le
            défaut venant du thème, une mise en page qui ne dit rien repart en
            capitales.

         2. 24 sp, contre 22 auparavant. Les consignes fixent ce corps pour
            les boutons d'action critiques, et la mesure porte : c'est le seuil
            au-delà duquel l'abandon de tâche diminue nettement.

         3. CONTRASTE. #1E8449 sous du texte blanc donnait 4,72:1, là où la
            norme AAA visée par les consignes en demande 7. Le vert est
            assombri à #145A31, soit 8,28:1 — mesuré, pas estimé — et reste
            franchement vert.

         4. PICTOGRAMME + TEXTE. Des analyses par oculométrie chez des seniors
            avec troubles cognitifs légers montrent que la paire icône large +
            texte descriptif accélère la reconnaissance et réduit les erreurs.
            La paire, pas l'un des deux : le texte reste donc à côté de
            l'icône, il ne la remplace pas et elle ne le remplace pas. -->
    <Button
        android:id="@+id/buttonAnswerNow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="24dp"
        android:text="Répondre maintenant"
        android:textSize="24sp"
        android:textAllCaps="false"
        android:drawableStart="@drawable/ic_repondre"
        android:drawablePadding="20dp"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:minHeight="88dp"
        android:minWidth="280dp"
        android:elevation="6dp"
        android:background="@drawable/fond_bouton_vert" />

    <!-- Même traitement, mêmes raisons (voir le bouton ci-dessus). Le rouge
         passe de #C0392B (5,44:1) à #96281B (8,03:1).

         Gabarit identique à son voisin, délibérément : deux boutons côte à
         côte de tailles différentes suggèrent que l'un compte plus que
         l'autre, alors que les deux gestes sont symétriques — et que celui-ci
         est le seul moyen pour Jean d'écarter un appel. -->
    <Button
        android:id="@+id/buttonBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="24dp"
        android:layout_marginEnd="24dp"
        android:text="Bloquer l'appel"
        android:textSize="24sp"
        android:textAllCaps="false"
        android:drawableStart="@drawable/ic_bloquer"
        android:drawablePadding="20dp"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:minHeight="88dp"
        android:minWidth="280dp"
        android:elevation="6dp"
        android:background="@drawable/fond_bouton_rouge" />

</FrameLayout>
