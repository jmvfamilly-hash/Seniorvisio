<?xml version="1.0" encoding="utf-8"?>
<!--
     Écran d'appel. Du point de vue de Jean ce n'est pas un autre écran que
     l'accueil : ce sont les mêmes trois zones (view_home_zones.xml, voir
     HomeZonesController), posées sur un fond qui change — la vidéo du proche
     à la place du fond uni, puis ses photos s'il lance un diaporama.

     L'ancien bandeau de sous-titres a disparu au profit de la zone 3, qui
     obéit aux mêmes règles que la zone des paroles de la pièce (voir
     PacedCaptionZone) : chaque phrase reste affichée le temps d'être lue, les
     suivantes attendent leur tour.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/callRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remoteRenderer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Photo de l'appelant en plein écran, derrière le nom et le décompte :
         un rond de 160dp était minuscule sur une dalle de dix pouces, alors
         que reconnaître la personne est précisément le but de cet écran. Le
         dégradé sombre par-dessus garde le nom et la barre lisibles quelle que
         soit la photo. Masquée tant qu'aucune photo n'est reçue : le fond du
         FrameLayout (posé selon la palette, voir ScreenTheme) reprend alors le
         dessus. -->
    <ImageView
        android:id="@+id/imageCallerPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Photo de l'appelant"
        android:visibility="gone" />

    <View
        android:id="@+id/callerPhotoScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/caller_photo_scrim"
        android:visibility="gone" />

    <!-- Photo du diaporama commenté à distance par le proche (voir
         WebRtcCallEngine.listenForSlideshowPhoto) : c'est lui qui fait défiler
         les photos depuis le PWA, Jean n'a rien à manipuler.

         Placée après la vidéo (qu'elle recouvre pendant le diaporama) mais
         avant les zones de texte, qui doivent rester lisibles par-dessus —
         c'est justement la combinaison des deux qui fait l'intérêt de la
         fonction : la photo en grand, et ce que raconte le proche écrit
         par-dessus.

         fitCenter et non centerCrop, contrairement à la photo d'appelant :
         une photo de famille recadrée arbitrairement couperait des visages,
         alors qu'ici le but est de regarder l'image en entier. -->
    <ImageView
        android:id="@+id/imageSlideshow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:background="#000000"
        android:contentDescription="Photo partagée par le proche"
        android:visibility="gone" />

    <!-- Nom de l'appelant et décompte, le temps de la sonnerie uniquement :
         masqué dès la connexion. Le repère date/moment/météo qui vivait ici
         en double a disparu — c'est la zone 1, présente en permanence
         par-dessus, qui s'en charge maintenant pour les deux écrans. -->
    <LinearLayout
        android:id="@+id/alertContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:id="@+id/textCallerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Appel de..."
            android:textColor="#FFFFFF"
            android:textSize="48sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Décompte : la barre qui se remplit doucement porte l'essentiel de
             l'information visuelle, le chiffre reste discret en dessous
             (recommandation ergonomique : éviter l'effet de compte à rebours
             anxiogène d'un gros chiffre qui défile). -->
        <FrameLayout
            android:id="@+id/countdownProgressContainer"
            android:layout_width="280dp"
            android:layout_height="10dp"
            android:layout_marginTop="28dp"
            android:background="#33FFFFFF">

            <View
                android:id="@+id/countdownProgressFill"
                android:layout_width="280dp"
                android:layout_height="10dp"
                android:background="#2ECC71" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="La visio démarre automatiquement"
            android:textColor="#999999"
            android:textSize="18sp"
            android:gravity="center" />

    </LinearLayout>

    <!-- Les trois zones, identiques à celles de l'écran d'accueil. -->
    <include layout="@layout/view_home_zones" />

    <!-- Miniature de Jean, au-dessus des zones : c'est un tout petit élément
         qu'un cadre de texte recouvrirait entièrement. Masquée par défaut,
         affichée seulement si le proche l'active depuis le PWA. -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/localRenderer"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:visibility="gone" />

    <!-- Version affichée en permanence, discrètement, pour vérifier à distance
         quel APK tourne réellement sur la tablette (voir BuildConfig.BUILD_REV). -->
    <TextView
        android:id="@+id/textBuildRev"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:textColor="#4DFFFFFF"
        android:textSize="11sp"
        android:text="" />

    <Button
        android:id="@+id/buttonBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="24dp"
        android:layout_marginEnd="24dp"
        android:text="Bloquer l'appel"
        android:textSize="22sp"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:backgroundTint="#C0392B" />

</FrameLayout>
