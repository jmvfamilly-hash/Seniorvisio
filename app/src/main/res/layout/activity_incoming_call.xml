<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B2A4A">

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remoteRenderer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/localRenderer"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:visibility="gone" />

    <!-- Photo de l'appelant en plein écran, derrière le nom et le décompte :
         un rond de 160dp était minuscule sur une dalle de dix pouces, alors
         que reconnaître la personne est précisément le but de cet écran. Le
         dégradé sombre par-dessus garde le nom et la barre lisibles quelle que
         soit la photo. Masquée tant qu'aucune photo n'est reçue : le fond uni
         du FrameLayout reprend alors le dessus (voir
         IncomingCallActivity.showCallerPhoto). -->
    <ImageView
        android:id="@+id/imageCallerPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Photo de l'appelant"
        android:visibility="gone" />

    <View
        android:id="@+id/callerPhotoScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/caller_photo_scrim"
        android:visibility="gone" />

    <!-- Photo du diaporama commenté à distance par le proche (voir
         WebRtcCallEngine.listenForSlideshowPhoto) : c'est lui qui fait défiler
         les photos depuis le PWA, Jean n'a rien à manipuler.

         Placée après la vidéo (qu'elle recouvre pendant le diaporama) mais
         avant le bandeau de sous-titres, qui doit rester lisible par-dessus —
         c'est justement la combinaison des deux qui fait l'intérêt de la
         fonction : la photo en grand, et ce que raconte le proche écrit
         dessous.

         fitCenter et non centerCrop, contrairement à la photo d'appelant :
         une photo de famille recadrée arbitrairement couperait des visages,
         alors qu'ici le but est de regarder l'image en entier. -->
    <ImageView
        android:id="@+id/imageSlideshow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:background="#000000"
        android:contentDescription="Photo partagée par le proche"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/alertContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:id="@+id/textCallerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Appel de..."
            android:textColor="#FFFFFF"
            android:textSize="48sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Décompte : la barre qui se remplit doucement porte l'essentiel de
             l'information visuelle, le chiffre reste discret en dessous
             (recommandation ergonomique : éviter l'effet de compte à rebours
             anxiogène d'un gros chiffre qui défile). -->
        <FrameLayout
            android:id="@+id/countdownProgressContainer"
            android:layout_width="280dp"
            android:layout_height="10dp"
            android:layout_marginTop="28dp"
            android:background="#33FFFFFF">

            <View
                android:id="@+id/countdownProgressFill"
                android:layout_width="280dp"
                android:layout_height="10dp"
                android:background="#2ECC71" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="La visio démarre automatiquement"
            android:textColor="#999999"
            android:textSize="18sp"
            android:gravity="center" />

        <!-- Même repère temporel que l'écran d'accueil (voir MainActivity et
             TimeContext/WeatherClient), en plus discret ici : le nom de
             l'appelant et le décompte restent l'essentiel de cet écran. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textCallMomentIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="28sp"
                android:text="" />

            <TextView
                android:id="@+id/textCallMomentLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#CCCCCC"
                android:textSize="16sp"
                android:text="" />

            <TextView
                android:id="@+id/textCallMomentWeatherSeparator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="#666666"
                android:textSize="16sp"
                android:visibility="gone"
                android:text="·" />

            <TextView
                android:id="@+id/textCallWeatherIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textSize="28sp"
                android:visibility="gone"
                android:text="" />

            <TextView
                android:id="@+id/textCallWeatherLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#CCCCCC"
                android:textSize="16sp"
                android:visibility="gone"
                android:text="" />
        </LinearLayout>

        <TextView
            android:id="@+id/textCallDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#888888"
            android:textSize="14sp"
            android:gravity="center"
            android:text="" />

    </LinearLayout>

    <!-- Sous-titres en surimpression (style sous-titrage TV) : la vidéo reste
         plein écran, le texte transcrit s'affiche dans un bandeau semi-opaque
         en bas. Activé/désactivé à distance par le proche depuis le PWA (voir
         WebRtcCallEngine.listenForCaptionMode) — apparaît et disparaît en
         fondu, pas de bouton local ici.

         Le texte n'est plus jamais tronqué : quand une phrase dépasse
         l'espace visible, captionScroll défile automatiquement jusqu'en bas
         (voir IncomingCallActivity.setupCaptionMode), à un rythme calculé
         sur le nombre de mots, plutôt que de couper avec des "…" et perdre
         la fin du texte pour Jean. -->
    <LinearLayout
        android:id="@+id/captionBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="140dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/caption_banner_bg"
        android:padding="20dp"
        android:visibility="gone"
        android:alpha="0">

        <ScrollView
            android:id="@+id/captionScroll"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scrollbars="none">

            <TextView
                android:id="@+id/textCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="@dimen/caption_text_size_default"
                android:text="" />
        </ScrollView>
    </LinearLayout>

    <!-- Version affichée en permanence, discrètement, pour vérifier à distance
         quel APK tourne réellement sur la tablette (voir BuildConfig.BUILD_REV). -->
    <TextView
        android:id="@+id/textBuildRev"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:textColor="#4DFFFFFF"
        android:textSize="11sp"
        android:text="" />

    <Button
        android:id="@+id/buttonBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="24dp"
        android:layout_marginEnd="24dp"
        android:text="Bloquer l'appel"
        android:textSize="22sp"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:backgroundTint="#C0392B" />

</FrameLayout>
