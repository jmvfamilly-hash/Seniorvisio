<?xml version="1.0" encoding="utf-8"?>
<!--
     Écran d'appel. Du point de vue de Jean ce n'est pas un autre écran que
     l'accueil : ce sont les mêmes trois zones (view_home_zones.xml, voir
     HomeZonesController), posées sur un fond qui change — la vidéo du proche
     à la place du fond uni, puis ses photos s'il lance un diaporama.

     L'ancien bandeau de sous-titres a disparu au profit de la zone 3, qui
     obéit aux mêmes règles que la zone des paroles de la pièce (voir
     PacedCaptionZone) : chaque phrase reste affichée le temps d'être lue, les
     suivantes attendent leur tour.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/callRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ═══ LES PHOTOS DE L'ACCUEIL, EN MODE « SOUS-TITRES » ═══

         PREMIER ENFANT, donc dessiné sous tout le reste — même mécanisme et
         même rôle que hotePhotos dans activity_main.xml, dont ceci est le
         jumeau. En mode « Sous-titres », l'écran de Jean ne doit pas changer :
         ses photos continuent de défiler, la date et la météo restent en
         place, et le texte du proche se pose par-dessus.

         Une vue à part plutôt que hoteRecueil, qui existe déjà plus bas :
         celui-ci est contraint dans une bande au-dessus du texte, pour les
         photos qu'un proche présente pendant un appel ordinaire. Ce sont deux
         usages différents de la même visionneuse, et leur donner la même vue
         forcerait chacun à défaire la mise en page de l'autre.

         Alimentée par LE MÊME OrdonnanceurPhotos que l'accueil (voir
         IncomingCallActivity.brancherPhotosAmbiantes) : pas une seconde
         galerie, pas une seconde cadence, pas un second rang.

         GONE partout ailleurs : pendant un appel ordinaire, c'est le visage
         du proche qui occupe la dalle. -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/hotePhotosAmbiantes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remoteRenderer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Photo du diaporama commenté à distance par le proche (voir
         WebRtcCallEngine.listenForSlideshowPhoto) : c'est lui qui fait défiler
         les photos depuis le PWA, Jean n'a rien à manipuler.

         Placée après la vidéo (qu'elle recouvre pendant le diaporama) mais
         avant les zones de texte, qui doivent rester lisibles par-dessus —
         c'est justement la combinaison des deux qui fait l'intérêt de la
         fonction : la photo en grand, et ce que raconte le proche écrit
         par-dessus.

         fitCenter et non centerCrop, contrairement à la photo d'appelant :
         une photo de famille recadrée arbitrairement couperait des visages,
         alors qu'ici le but est de regarder l'image en entier. -->
    <ImageView
        android:id="@+id/imageSlideshow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:background="#000000"
        android:contentDescription="Photo partagée par le proche"
        android:visibility="gone" />

    <!-- Élément d'un RECUEIL, que le proche fait défiler pendant l'appel (voir
         LecteurRecueil et CallSignalingClient.listenForRecueilCommande).

         ═══ POURQUOI UNE VUE À PART DU DIAPORAMA CI-DESSUS ═══

         Les deux montrent une photo, mais pas au même endroit : le diaporama
         prend tout l'écran, un recueil prend LA BANDE de la vidéo du proche —
         la même que fitVideoAboveCaptions accorde au visage — pour que la
         transcription reste lisible dessous pendant qu'il commente.

         Une seule vue partagée obligerait à sauvegarder et restaurer sa
         géométrie à chaque bascule. Ce projet a déjà cassé deux fois la mise
         en page de cet écran dans la même journée ; deux vues distinctes, dont
         une seule est visible à la fois, coûtent quelques octets et retirent
         toute une classe d'erreurs.

         La hauteur est posée par le code, comme pour la vidéo.

         ═══ UNE ComposeView, ET TOUTE LA LARGEUR ═══

         C'était une ImageView en wrap_content avec adjustViewBounds, pour
         qu'elle prenne les proportions de la photo dans la bande accordée.

         C'est désormais l'hôte de la visionneuse (voir VisionneusePhotos) — la
         MÊME que sur l'accueil, ce qui était tout l'objet de la manœuvre. Elle
         prend match_parent en largeur parce qu'un pager doit disposer de toute
         la largeur pour faire glisser d'une photo à l'autre ; c'est la photo
         elle-même qui se centre dans cette largeur, en conservant ses
         proportions (ContentScale.Fit). -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/hoteRecueil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="top|center_horizontal"
        android:visibility="gone" />

    <!-- Ce que la tablette ne sait pas afficher, ou n'a pas trouvé : dit à
         l'écran plutôt que laissé en noir. Un recueil dont une photo manque ne
         doit pas donner l'impression que l'appel a planté. -->
    <TextView
        android:id="@+id/textRecueilImpossible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:gravity="center"
        android:padding="24dp"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:visibility="gone" />

    <!-- ═══ JEAN NAVIGUE LUI-MÊME ═══

         Jusqu'ici, seul le proche faisait défiler les photos et les titres
         depuis le PWA. Ces deux boutons ouvrent le même chemin à Jean, sans
         rien retirer à l'autre : LecteurRecueil ignore d'où vient la commande,
         c'est la couture prévue pour ça dès l'origine (voir
         docs/architecture-recueils.md, § 5).

         Cela ne contredit pas « Jean n'a jamais rien à faire » : il n'a
         toujours RIEN À FAIRE — l'appel se connecte seul, les photos défilent
         si le proche les fait défiler. Il a maintenant quelque chose qu'il
         PEUT faire, ce qui n'est pas la même chose.

         Visible seulement quand une photo ou un titre est à l'écran (voir
         IncomingCallActivity) : deux boutons qui ne commandent rien invitent à
         les toucher, puis à les croire cassés.

         ═══ L'ESPACEMENT N'EST PAS DE LA MISE EN PAGE ═══

         L'espaceur central porte une largeur minimale et un poids : les deux
         boutons ne peuvent donc jamais se toucher, quels que soient la police
         choisie et la longueur des libellés. Les consignes demandent 16 à
         24 dp de vide entre deux cibles parce que les erreurs de visée sont
         fréquentes — un tremblement suffit à déclencher l'action voisine, et
         ici la voisine est « photo précédente », pas « quitter ». Le vide est
         donc garanti par la structure, pas obtenu par hasard sur une dalle
         large. -->
    <LinearLayout
        android:id="@+id/barreNavigationRecueil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <Button
            android:id="@+id/boutonRecueilPrecedent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Précédente"
            android:textSize="24sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:drawableStart="@drawable/ic_precedent"
            android:drawablePadding="16dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:minHeight="88dp"
            android:minWidth="240dp"
            android:elevation="6dp"
            android:background="@drawable/fond_bouton_navigation" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:minWidth="24dp" />

        <Button
            android:id="@+id/boutonRecueilSuivant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Suivante"
            android:textSize="24sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:drawableEnd="@drawable/ic_suivant"
            android:drawablePadding="16dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:minHeight="88dp"
            android:minWidth="240dp"
            android:elevation="6dp"
            android:background="@drawable/fond_bouton_navigation" />
    </LinearLayout>

    <!-- ═══ PLEINE HAUTEUR : TEXTE À GAUCHE, PHOTO À DROITE ═══

         Remplace l'ancienne mise en page (photo plein écran, texte centré
         par-dessus avec un voile sombre pour rester lisible), puis l'ancienne
         bande basse de 300dp : les deux informations qui comptent — « il se
         passe un appel » et « qui appelle » — occupent maintenant chacune une
         moitié de l'écran, sur toute sa hauteur.

         Fond BLANC au départ à gauche, qui passe au vert en douceur pendant
         les dix premières secondes (voir IncomingCallActivity.
         demarrerTransitionCouleurAppel) — pas teinté selon la palette
         jour/nuit : la transition se voit pareil quelle que soit l'heure. -->
    <LinearLayout
        android:id="@+id/alertContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/alertLeftPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <!-- Première chose lisible, même d'un coup d'œil depuis l'autre
                 bout de la pièce : ce qui se passe, avant même de savoir qui
                 appelle. -->
            <TextView
                android:id="@+id/textAppelEnCours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appel en cours"
                android:textSize="56sp"
                android:textStyle="bold"
                android:textColor="#101A2E"
                android:gravity="center" />

            <TextView
                android:id="@+id/textCallerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Appel de..."
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#41506A"
                android:gravity="center" />

            <!-- Décompte : la barre qui se remplit doucement porte l'essentiel
                 de l'information visuelle, le chiffre reste discret en
                 dessous (recommandation ergonomique : éviter l'effet de
                 compte à rebours anxiogène d'un gros chiffre qui défile). -->
            <FrameLayout
                android:id="@+id/countdownProgressContainer"
                android:layout_width="280dp"
                android:layout_height="28dp"
                android:layout_marginTop="20dp"
                android:background="#22000000">

                <View
                    android:id="@+id/countdownProgressFill"
                    android:layout_width="280dp"
                    android:layout_height="28dp"
                    android:background="#2ECC71" />
            </FrameLayout>

            <TextView
                android:id="@+id/textCountdownHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="La visio démarre automatiquement"
                android:textSize="16sp"
                android:textColor="#41506A"
                android:gravity="center" />
        </LinearLayout>

        <!-- Fond neutre tant qu'aucune photo n'est reçue (capture webcam prise
             à l'ouverture de l'appel, sinon photo déposée à l'avance par le
             proche — voir showCallerPhoto) : un panneau vide donnerait
             l'impression d'un écran cassé. -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#263447">

            <ImageView
                android:id="@+id/imageCallerPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Photo de l'appelant"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Les trois zones, identiques à celles de l'écran d'accueil. -->
    <include layout="@layout/view_home_zones" />

    <!-- N'est jamais montrée ici : cet écran n'a pas de bouton « Sous-titres »
         à annoncer (voir MainActivity.brancherBoutonTranscription, qui ne
         tourne que sur l'accueil). Le même id existe quand même, invisible et
         vide, parce que HomeZonesController le lit sans condition quel que
         soit l'écran hôte (voir activity_main.xml pour la version réellement
         affichée). -->
    <TextView
        android:id="@+id/textConsigneSousTitres"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:text="" />

    <!-- ═══ MOMENT DE LA JOURNÉE ET « ÉCRAN NOIR », EN BAS À GAUCHE ═══

         Montrés seulement en mode « Sous-titres » (voir préparerÉcranSousTitres,
         qui ramène zoneInfo en fond SOLID). zoneInfo les a perdus (voir
         view_home_zones.xml) : HomeZonesController les lit sans condition,
         ils doivent donc exister ici aussi.

         Tous deux à GAUCHE, contrairement à l'accueil où « Écran noir » est à
         droite : à droite ici, c'est la place de groupeRaccrocher (la
         consigne et le bouton rouge), qui lui ne disparaît jamais, y compris
         en mode « Sous-titres » — les deux s'y chevaucheraient.

         GONE par défaut, rendu visible SEULEMENT dans préparerÉcranSousTitres
         (voir IncomingCallActivity) : ce groupe est un ajout tardif, posé en
         dehors de zoneInfo (que setBackground() cache déjà correctement
         pendant un appel vidéo ordinaire, voir HomeZonesController) — sans ce
         visibility explicite, il restait affiché par défaut, directement
         par-dessus la vidéo du proche, y compris hors mode « Sous-titres »
         (signalé après essai : le moment de la journée se voyait sur
         l'image de l'appelant). -->
    <LinearLayout
        android:id="@+id/groupeMomentEtSommeilAppel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="32dp"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/textMomentIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="44sp"
            android:text="" />

        <TextView
            android:id="@+id/textMomentLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:textSize="34sp"
            android:textStyle="bold"
            android:text="" />

        <Button
            android:id="@+id/boutonSommeil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:minWidth="108dp"
            android:minHeight="108dp"
            android:text="Écran noir"
            android:textSize="20sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:drawableTop="@drawable/ic_sommeil"
            android:drawablePadding="4dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:elevation="6dp"
            android:background="@drawable/fond_bouton_navigation" />
    </LinearLayout>

    <!-- Miniature de Jean, au-dessus des zones : c'est un tout petit élément
         qu'un cadre de texte recouvrirait entièrement. Masquée par défaut,
         affichée seulement si le proche l'active depuis le PWA. -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/localRenderer"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:visibility="gone" />

    <!-- Version affichée en permanence, discrètement, pour vérifier à distance
         quel APK tourne réellement sur la tablette (voir BuildConfig.BUILD_REV). -->
    <TextView
        android:id="@+id/textBuildRev"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:textColor="#4DFFFFFF"
        android:textSize="11sp"
        android:text="" />

    <!-- ═══ PULSE D'ATTENTION, 2 S, À L'ARRIVÉE D'UN APPEL ═══

         Un seul pulse doux (voir IncomingCallActivity.pulseAttentionAppel),
         jamais un clignotement répété : au-delà d'un pulse isolé, le risque
         de déclencher une crise chez une personne photosensible devient réel
         — inacceptable sur un appareil destiné à une personne âgée.

         Non interactif (clickable/focusable à faux) : il ne doit jamais
         intercepter un appui destiné aux boutons Répondre/Bloquer, placés
         après lui dans l'empilement et donc toujours par-dessus à l'écran. -->
    <View
        android:id="@+id/pulseAttentionAppel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:alpha="0"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <!-- Répondre sans attendre la fin du décompte.
         Pour qui se trouve déjà dans la pièce — un proche en visite, quelqu'un
         qui passe — et n'a aucune raison de regarder une barre se remplir
         pendant trente secondes alors que la conversation peut commencer tout
         de suite. Jean, lui, n'a toujours rien à faire : sans personne pour y
         toucher, le décompte va au bout et l'appel se connecte seul, exactement
         comme avant.
         Disparaît dès la connexion (voir connectVideoCall) : il n'a plus de
         sens une fois l'appel établi, et deux boutons côte à côte pendant la
         conversation invitent à en toucher un par erreur. -->
    <!-- ═══ REFAIT SELON LES CONSIGNES D'ACCESSIBILITÉ ═══

         Quatre exigences tenaient sur ce seul bouton, et il en manquait trois.

         1. PAS DE CAPITALES. Le thème de cette application est
            Theme.AppCompat, dont Widget.AppCompat.Button impose
            textAllCaps : ce bouton affichait « RÉPONDRE MAINTENANT ». Or le
            cerveau reconnaît un mot à sa silhouette globale ; en capitales,
            tous les mots deviennent des blocs rectangulaires de même hauteur,
            et il faut les déchiffrer lettre par lettre. C'est coûteux pour
            tout le monde et davantage en cas de trouble cognitif.
            Posé en XML ici ET dans le code (voir MiseEnFormeSenior) : le
            défaut venant du thème, une mise en page qui ne dit rien repart en
            capitales.

         2. 24 sp, contre 22 auparavant. Les consignes fixent ce corps pour
            les boutons d'action critiques, et la mesure porte : c'est le seuil
            au-delà duquel l'abandon de tâche diminue nettement.

         3. CONTRASTE. #1E8449 sous du texte blanc donnait 4,72:1, là où la
            norme AAA visée par les consignes en demande 7. Le vert est
            assombri à #145A31, soit 8,28:1 — mesuré, pas estimé — et reste
            franchement vert.

         4. PICTOGRAMME + TEXTE. Des analyses par oculométrie chez des seniors
            avec troubles cognitifs légers montrent que la paire icône large +
            texte descriptif accélère la reconnaissance et réduit les erreurs.
            La paire, pas l'un des deux : le texte reste donc à côté de
            l'icône, il ne la remplace pas et elle ne le remplace pas. -->
    <!-- Icône et texte sombres, et fond vert clair plutôt que
         fond_bouton_vert : depuis que le panneau derrière ce bouton peut lui
         aussi devenir vert (voir demarrerTransitionCouleurAppel), l'ancien
         fond #145A31 s'y noyait complètement — signalé après essai sur la
         tablette. Voir fond_bouton_vert_clair pour le contraste mesuré. -->
    <Button
        android:id="@+id/buttonAnswerNow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="24dp"
        android:text="Répondre maintenant"
        android:textSize="24sp"
        android:textAllCaps="false"
        android:textColor="#101A2E"
        android:drawableStart="@drawable/ic_repondre_sombre"
        android:drawablePadding="20dp"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:minHeight="88dp"
        android:minWidth="280dp"
        android:elevation="6dp"
        android:background="@drawable/fond_bouton_vert_clair" />

    <!-- ═══ LA CONSIGNE ET SON BOUTON, DANS UN SEUL GROUPE ═══

         « Bloquez si vous le souhaitez » reste affichée au-dessus du bouton
         rouge tout le temps — pendant la sonnerie ET pendant l'appel connecté
         (ce bouton ne disparaît jamais, voir connectVideoCall qui masque
         alertContent mais pas ce groupe, contrairement à buttonAnswerNow).

         Un seul groupe plutôt que deux vues indépendantes : les garder
         séparées aurait demandé de recalculer la position de la consigne à
         chaque rotation d'écran EN PLUS de celle du bouton (voir
         applyOrientationLayout, qui déplace désormais ce groupe entier d'un
         bloc), pour un résultat qui aurait fini par diverger au premier
         oubli.

         Fond semi-opaque sur la consigne (voir fond_consigne_appel) : à cet
         endroit c'est tantôt la vidéo du proche, tantôt une photo
         quelconque qui se trouve derrière, jamais un fond choisi.

         Même traitement que toujours pour le bouton lui-même : rouge
         #96281B, 8,03:1. Mêmes dimensions que buttonAnswerNow, délibérément :
         deux boutons de tailles différentes suggèrent que l'un compte plus
         que l'autre, alors que les deux gestes sont symétriques. -->
    <LinearLayout
        android:id="@+id/groupeRaccrocher"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/textBlockHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Bloquez si vous le souhaitez"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/fond_consigne_appel"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

        <Button
            android:id="@+id/buttonBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="Bloquer l'appel"
            android:textSize="24sp"
            android:textAllCaps="false"
            android:drawableStart="@drawable/ic_bloquer"
            android:drawablePadding="20dp"
            android:paddingLeft="32dp"
            android:paddingRight="32dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:minHeight="88dp"
            android:minWidth="280dp"
            android:elevation="6dp"
            android:background="@drawable/fond_bouton_rouge" />
    </LinearLayout>

</FrameLayout>
