<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B2A4A">

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remoteRenderer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/localRenderer"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/alertContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <ImageView
            android:id="@+id/imageCallerPhoto"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginBottom="24dp"
            android:background="#2C3E5C"
            android:scaleType="centerCrop"
            android:contentDescription="Photo de l'appelant"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textCallerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Appel de..."
            android:textColor="#FFFFFF"
            android:textSize="48sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Décompte : la barre qui se remplit doucement porte l'essentiel de
             l'information visuelle, le chiffre reste discret en dessous
             (recommandation ergonomique : éviter l'effet de compte à rebours
             anxiogène d'un gros chiffre qui défile). -->
        <FrameLayout
            android:id="@+id/countdownProgressContainer"
            android:layout_width="280dp"
            android:layout_height="10dp"
            android:layout_marginTop="28dp"
            android:background="#33FFFFFF">

            <View
                android:id="@+id/countdownProgressFill"
                android:layout_width="280dp"
                android:layout_height="10dp"
                android:background="#2ECC71" />
        </FrameLayout>

        <TextView
            android:id="@+id/textCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="30 s"
            android:textColor="#8FA0BF"
            android:textSize="18sp"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="La visio démarre automatiquement"
            android:textColor="#999999"
            android:textSize="18sp"
            android:gravity="center" />

    </LinearLayout>

    <!-- Sous-titres en surimpression (style sous-titrage TV) : la vidéo reste
         plein écran, le texte transcrit s'affiche dans un bandeau semi-opaque
         en bas, 3 lignes max. Activé/désactivé à distance par le proche
         depuis le PWA (voir WebRtcCallEngine.listenForCaptionMode) — apparaît
         et disparaît en fondu, pas de bouton local ici. -->
    <LinearLayout
        android:id="@+id/captionBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="140dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/caption_banner_bg"
        android:padding="20dp"
        android:visibility="gone"
        android:alpha="0">

        <TextView
            android:id="@+id/textCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="32sp"
            android:maxLines="3"
            android:ellipsize="end"
            android:text="" />
    </LinearLayout>

    <Button
        android:id="@+id/buttonBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:text="Bloquer l'appel"
        android:textSize="22sp"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:backgroundTint="#C0392B" />

</FrameLayout>
