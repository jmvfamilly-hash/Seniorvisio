<?xml version="1.0" encoding="utf-8"?>
<!--
     Écran d'accueil (hors appel). Deux vues exclusives : l'attente (titre +
     bouton pour activer les sous-titres de la pièce) et l'affichage des
     sous-titres eux-mêmes une fois activés (voir MainActivity.kt).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B2A4A">

    <LinearLayout
        android:id="@+id/idleContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:id="@+id/textIdleTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Senior Visio\n(en attente d'appel)"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:gravity="center" />

        <Button
            android:id="@+id/buttonRoomCaptions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="🔤 Sous-titres"
            android:textSize="24sp"
            android:paddingLeft="40dp"
            android:paddingRight="40dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:backgroundTint="#2ECC71" />

    </LinearLayout>

    <!-- Sous-titres de la pièce : reconnaissance vocale locale de la tablette
         (pas de proche impliqué ici, donc pas d'autre choix que de faire
         tourner la reconnaissance directement sur l'appareil). Historique
         complet conservé (voir MainActivity.roomCaptionSentences) : Jean
         peut remonter à la main pour relire une phrase précédente, le
         défilement automatique ne le ramène pas de force en bas s'il a
         déplacé la vue (voir MainActivity.isRoomCaptionScrollNearBottom). La
         dernière phrase est mise en valeur (gras, pleine opacité) pour la
         repérer d'un coup d'œil parmi l'historique, plus discret.

         Bandeau centré à l'écran, géré exactement comme le bandeau des
         sous-titres d'appel (voir activity_incoming_call.xml et
         IncomingCallActivity.applyOrientationLayout) : même fond
         (caption_banner_bg), mêmes marges latérales adaptées à
         l'orientation — sauf que centré plutôt qu'en bas, faute de vidéo à
         laisser plein écran ici. Voir MainActivity.applyRoomCaptionLayout
         pour le calcul dynamique des marges/hauteur (plafond augmenté de
         50% par rapport à l'équivalent en appel, plus de place ici que la
         vidéo n'en laisse côté appel). -->
    <LinearLayout
        android:id="@+id/roomCaptionBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/caption_banner_bg"
        android:padding="20dp"
        android:visibility="gone">

        <ScrollView
            android:id="@+id/roomCaptionScroll"
            android:layout_width="match_parent"
            android:layout_height="330dp"
            android:scrollbars="none">

            <TextView
                android:id="@+id/textRoomCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/caption_text_size_default"
                android:text="" />
        </ScrollView>
    </LinearLayout>

    <!-- Taille du texte réglable directement par Jean (pas de proche à
         distance pour le faire ici, contrairement aux sous-titres d'appel) —
         voir AdminConfig.roomCaptionTextSizeSp. -->
    <LinearLayout
        android:id="@+id/roomCaptionTextSizeControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/buttonRoomTextSmaller"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:padding="0dp"
            android:text="A-"
            android:textSize="16sp"
            android:backgroundTint="#33FFFFFF" />

        <Button
            android:id="@+id/buttonRoomTextLarger"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:padding="0dp"
            android:text="A+"
            android:textSize="20sp"
            android:backgroundTint="#33FFFFFF" />

    </LinearLayout>

    <!-- Version affichée en permanence, discrètement, pour vérifier à distance
         quel APK tourne réellement sur la tablette (voir BuildConfig.BUILD_REV) —
         sans ça, impossible de savoir si un déploiement Headwind a pris effet
         sans brancher physiquement l'appareil. -->
    <TextView
        android:id="@+id/textBuildRev"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:textColor="#4DFFFFFF"
        android:textSize="11sp"
        android:text="" />

    <Button
        android:id="@+id/buttonStopRoomCaptions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:visibility="gone"
        android:text="Arrêter les sous-titres"
        android:textSize="20sp"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:backgroundTint="#C0392B" />

</FrameLayout>
