<?xml version="1.0" encoding="utf-8"?>
<!--
     Écran d'attente (hors appel). Volontairement réduit à l'essentiel : une
     horloge (voir MainActivity.updateClock) et un gros bouton qui bascule vers
     la transcription des conversations de la pièce (application Google, voir
     MainActivity.launchRoomTranscription et CompanionApps).

     Le bandeau de sous-titres qui vivait ici a disparu avec la
     reconnaissance vocale maison : c'est désormais l'application de Google
     qui affiche le texte, en plein écran, et le bouton Accueil ramène ici
     (voir KioskManager).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B2A4A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <!-- Horloge : seule information réellement utile à Jean sur cet écran,
             à la place du nom de l'application et du "en attente d'appel" qui
             s'y trouvaient — ni l'un ni l'autre ne lui servaient à quoi que ce
             soit, et "en attente" pouvait même laisser croire qu'il avait
             quelque chose à faire.

             Heure très grande et lisible de loin, date écrite en toutes lettres
             plutôt qu'en chiffres (03/09 se déchiffre, "mercredi 3 septembre"
             se lit) : se repérer dans le temps est un besoin quotidien concret
             quand les journées se ressemblent. -->
        <TextView
            android:id="@+id/textClockTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="120sp"
            android:textStyle="bold"
            android:gravity="center"
            android:text="" />

        <TextView
            android:id="@+id/textClockDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#D6DEEA"
            android:textSize="36sp"
            android:gravity="center"
            android:text="" />

        <Button
            android:id="@+id/buttonRoomCaptions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="🔤 Sous-titres"
            android:textSize="24sp"
            android:paddingLeft="40dp"
            android:paddingRight="40dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:backgroundTint="#2ECC71" />

    </LinearLayout>

    <!-- Version affichée en permanence, discrètement, pour vérifier quel APK
         tourne réellement sur la tablette sans la brancher (voir
         BuildConfig.BUILD_REV). Appui long : accès aux réglages admin. -->
    <TextView
        android:id="@+id/textBuildRev"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:textColor="#4DFFFFFF"
        android:textSize="11sp"
        android:text="" />

</FrameLayout>
