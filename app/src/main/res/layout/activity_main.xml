<?xml version="1.0" encoding="utf-8"?>
<!--
     Écran d'attente (hors appel). Volontairement réduit à l'essentiel : un
     titre et un gros bouton qui bascule vers la transcription des
     conversations de la pièce (application Google, voir
     MainActivity.launchRoomTranscription et CompanionApps).

     Le bandeau de sous-titres qui vivait ici a disparu avec la
     reconnaissance vocale maison : c'est désormais l'application de Google
     qui affiche le texte, en plein écran, et le bouton Accueil ramène ici
     (voir KioskManager).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B2A4A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:id="@+id/textIdleTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Senior Visio\n(en attente d'appel)"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:gravity="center" />

        <Button
            android:id="@+id/buttonRoomCaptions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="🔤 Sous-titres"
            android:textSize="24sp"
            android:paddingLeft="40dp"
            android:paddingRight="40dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:backgroundTint="#2ECC71" />

    </LinearLayout>

    <!-- Version affichée en permanence, discrètement, pour vérifier quel APK
         tourne réellement sur la tablette sans la brancher (voir
         BuildConfig.BUILD_REV). Appui long : accès aux réglages admin. -->
    <TextView
        android:id="@+id/textBuildRev"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:textColor="#4DFFFFFF"
        android:textSize="11sp"
        android:text="" />

</FrameLayout>
