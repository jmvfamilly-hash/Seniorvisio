<?xml version="1.0" encoding="utf-8"?>
<!--
     Écran d'attente (hors appel). Volontairement réduit à l'essentiel : une
     horloge (voir MainActivity.updateClock) et un gros bouton qui bascule vers
     la transcription des conversations de la pièce (application Google, voir
     MainActivity.launchRoomTranscription et CompanionApps).

     Le bandeau de sous-titres qui vivait ici a disparu avec la
     reconnaissance vocale maison : c'est désormais l'application de Google
     qui affiche le texte, en plein écran, et le bouton Accueil ramène ici
     (voir KioskManager).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B2A4A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <!-- Horloge : seule information réellement utile à Jean sur cet écran,
             à la place du nom de l'application et du "en attente d'appel" qui
             s'y trouvaient — ni l'un ni l'autre ne lui servaient à quoi que ce
             soit, et "en attente" pouvait même laisser croire qu'il avait
             quelque chose à faire.

             Heure très grande et lisible de loin, date écrite en toutes lettres
             plutôt qu'en chiffres (03/09 se déchiffre, "mercredi 3 septembre"
             se lit) : se repérer dans le temps est un besoin quotidien concret
             quand les journées se ressemblent. -->
        <TextView
            android:id="@+id/textClockTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="120sp"
            android:textStyle="bold"
            android:gravity="center"
            android:text="" />

        <TextView
            android:id="@+id/textClockDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#D6DEEA"
            android:textSize="36sp"
            android:gravity="center"
            android:text="" />

        <!-- Zone réservée aux deux services accessibles depuis l'accueil. Deux
             cartes de même taille, côte à côte : à gauche ce que Jean déclenche
             lui-même (les sous-titres de la pièce), à droite ce qu'un visiteur
             déclenche pour lui (le QR code du soignant). Volontairement
             surdimensionnées — une cible tactile large et contrastée est ce qui
             distingue un écran utilisable d'un écran théoriquement utilisable. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:orientation="horizontal">

            <!-- Sous-titres de la pièce : bascule vers l'application Google
                 (voir MainActivity.launchRoomTranscription). Le libellé dit ce
                 que ça fait, pas comment ça s'appelle : "Transcription
                 instantanée" ne veut rien dire pour Jean, "voir ce qui se dit"
                 si. Le retour d'appui est explicite (voir onClick). -->
            <LinearLayout
                android:id="@+id/cardRoomCaptions"
                android:layout_width="340dp"
                android:layout_height="300dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/home_card_bg"
                android:padding="24dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👂"
                    android:textSize="86sp" />

                <TextView
                    android:id="@+id/textRoomCaptionsLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Voir ce qui se dit"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/textRoomCaptionsHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/room_captions_hint"
                    android:textColor="#AEBBD0"
                    android:textSize="18sp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- QR code à faire scanner par un soignant/visiteur présent dans
                 la pièce : son téléphone devient un micro qui écrit en grand
                 sur cette tablette (voir MainActivity.buildCaregiverQrCode).
                 Appuyer dessus explique la fonction à celui qui la découvre. -->
            <LinearLayout
                android:id="@+id/cardCaregiverQr"
                android:layout_width="340dp"
                android:layout_height="300dp"
                android:layout_marginStart="32dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/home_card_bg"
                android:padding="24dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imageCaregiverQr"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:contentDescription="QR code à scanner pour parler à Jean" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Vous êtes avec Jean&#160;?"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Scannez : il lira vos paroles"
                    android:textColor="#AEBBD0"
                    android:textSize="18sp"
                    android:gravity="center" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Version affichée en permanence, discrètement, pour vérifier quel APK
         tourne réellement sur la tablette sans la brancher (voir
         BuildConfig.BUILD_REV). Appui long : accès aux réglages admin. -->
    <TextView
        android:id="@+id/textBuildRev"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:textColor="#4DFFFFFF"
        android:textSize="11sp"
        android:text="" />

</FrameLayout>
