<?xml version="1.0" encoding="utf-8"?>
<!--
     Écran d'accueil (hors appel). Un seul écran permanent maintenant : le
     titre discret, l'historique des dictées (vide au départ) et le bouton à
     maintenir enfoncé pour dicter, toujours visible en bas (voir
     MainActivity.kt).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B2A4A"
    android:orientation="vertical">

    <TextView
        android:id="@+id/textIdleTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Senior Visio"
        android:textColor="#8FA0BF"
        android:textSize="18sp"
        android:gravity="center"
        android:padding="16dp" />

    <!-- Historique des dictées : reconnaissance vocale locale de la tablette
         (pas de proche impliqué ici, donc pas d'autre choix que de faire
         tourner la reconnaissance directement sur l'appareil). Chaque
         dictée (une pression maintenue du bouton ci-dessous) s'ajoute à la
         suite, séparée visuellement de la précédente. Le défilement automatique
         (voir MainActivity.kt) avance à une vitesse plafonnée, comme pour les
         sous-titres d'appel, pour laisser le temps de lire ; il se met en
         pause dès que Jean touche l'écran pour naviguer manuellement dans
         l'historique, et reprend son rythme dès qu'il relâche. -->
    <ScrollView
        android:id="@+id/roomCaptionScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="24dp">

        <TextView
            android:id="@+id/textRoomCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="36sp"
            android:text="" />
    </ScrollView>

    <Button
        android:id="@+id/buttonRoomCaptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:text="🎙️ Maintenir pour dicter"
        android:textSize="22sp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:backgroundTint="#2ECC71" />

</LinearLayout>
