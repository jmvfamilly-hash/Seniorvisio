<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="hello word"
        android:textSize="16sp"
        android:textStyle="bold" />

    <CheckBox
        android:id="@+id/checkboxShowPasswords"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Afficher les mots de passe et codes en clair" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Durée du décompte (secondes)"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/inputCountdownSeconds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="PIN admin"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/inputAdminPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="numberPassword" />

    <Button
        android:id="@+id/buttonSaveAdminSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Enregistrer" />

    <!-- Utile à l'arrivée dans un nouveau lieu (ex. maison de retraite), où
         le réseau diffère de celui utilisé pendant les tests — seul moyen de
         changer de Wi-Fi une fois en mode kiosque, sans accès aux Réglages
         système (voir WifiConfigurator.kt). Fonctionne uniquement une fois
         la tablette provisionnée en Device Owner. -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Wi-Fi de la tablette"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/buttonScanWifiQr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="📷 Scanner un QR Wi-Fi"
        android:backgroundTint="#2ECC71" />

    <Button
        android:id="@+id/buttonPickWifiNetwork"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="📶 Choisir un réseau à proximité"
        android:backgroundTint="#3498DB" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Ou saisir manuellement :"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Nom du réseau (SSID)"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/inputWifiSsid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Mot de passe (laisser vide si réseau ouvert avec portail de connexion)"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/inputWifiPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textPassword" />

    <Button
        android:id="@+id/buttonConnectWifi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Se connecter à ce Wi-Fi" />

    <TextView
        android:id="@+id/textWifiStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="14sp"
        android:text="" />

    <!-- Réseau ouvert type Wifirst (courant en résidence senior) : Wi-Fi
         associé sans mot de passe, mais Internet bloqué tant qu'un code
         personnel n'est pas validé sur une page web (portail captif) —
         voir WifiConfigurator.checkInternetReachable. Ce WebView permet de
         valider ce portail directement depuis l'app, sans sortir du mode
         kiosque (un navigateur/notification système externe n'y est pas
         accessible, voir KioskManager). -->
    <WebView
        android:id="@+id/webViewCaptivePortal"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/buttonValidateCaptivePortal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="J'ai validé le portail — revérifier"
        android:visibility="gone" />

    <!-- Utilisée uniquement par le labo de comparaison de transcription
         (voir TranscriptionLabActivity.kt), jamais par les sous-titres en
         usage normal. -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Clé API AssemblyAI (labo de transcription)"
        android:textSize="16sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/inputAssemblyAiKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textPassword" />

</LinearLayout>
</ScrollView>
