<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:id="@+id/textInstalledVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:textSize="16sp"
        android:textStyle="bold" />

    <CheckBox
        android:id="@+id/checkboxShowPasswords"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Afficher les mots de passe et codes en clair" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Durée du décompte (secondes)"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/inputCountdownSeconds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="PIN admin"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/inputAdminPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="numberPassword" />

    <Button
        android:id="@+id/buttonSaveAdminSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Enregistrer" />

    <!-- Utile à l'arrivée dans un nouveau lieu (ex. maison de retraite), où
         le réseau diffère de celui utilisé pendant les tests — seul moyen de
         changer de Wi-Fi une fois en mode kiosque, sans accès aux Réglages
         système (voir WifiConfigurator.kt). Fonctionne uniquement une fois
         la tablette provisionnée en Device Owner. -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Wi-Fi de la tablette"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/buttonScanWifiQr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="📷 Scanner un QR Wi-Fi"
        android:backgroundTint="#2ECC71" />

    <Button
        android:id="@+id/buttonPickWifiNetwork"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="📶 Choisir un réseau à proximité"
        android:backgroundTint="#3498DB" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Ou saisir manuellement :"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Nom du réseau (SSID)"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/inputWifiSsid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Mot de passe (laisser vide si réseau ouvert avec portail de connexion)"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/inputWifiPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textPassword" />

    <Button
        android:id="@+id/buttonConnectWifi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Se connecter à ce Wi-Fi" />

    <TextView
        android:id="@+id/textWifiStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="14sp"
        android:text="" />

    <!-- Réseau ouvert type Wifirst (courant en résidence senior) : Wi-Fi
         associé sans mot de passe, mais Internet bloqué tant qu'un code
         personnel n'est pas validé sur une page web (portail captif) —
         voir WifiConfigurator.checkInternetReachable. Ce WebView permet de
         valider ce portail directement depuis l'app, sans sortir du mode
         kiosque (un navigateur/notification système externe n'y est pas
         accessible, voir KioskManager). -->
    <WebView
        android:id="@+id/webViewCaptivePortal"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/buttonValidateCaptivePortal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="J'ai validé le portail — revérifier"
        android:visibility="gone" />

    <!-- Repli quand le portail de la résidence ne se prête pas à l'écran
         captif intégré ci-dessus (une simple WebView) : certains portails
         demandent un vrai navigateur (JavaScript avancé, session à plusieurs
         pages...). Ouvre une fenêtre de maintenance temporaire autorisant un
         navigateur en mode kiosque (voir KioskManager.
         grantTemporaryBrowserAccess) — jamais un accès permanent, qui
         viderait le mode kiosque de son sens. -->
    <Button
        android:id="@+id/buttonOpenBrowser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="🌐 Ouvrir un navigateur (10 min)"
        android:backgroundTint="#8E44AD" />

    <TextView
        android:id="@+id/textBrowserAccessStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="14sp"
        android:text="" />

    <!-- Utilisée uniquement par le labo de comparaison de transcription
         (voir TranscriptionLabActivity.kt), jamais par les sous-titres en
         usage normal. -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Clé API AssemblyAI (labo de transcription)"
        android:textSize="16sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/inputAssemblyAiKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textPassword" />

    <!-- État en direct de la surveillance du son (voir
         RoomPresenceService.currentStatus). Le seuil de déclenchement dépend
         du microphone et de l'acoustique de la pièce : sans voir le niveau
         réellement mesuré en face, on le règle à l'aveugle. Et quand le
         réveil ne se déclenche pas, ces lignes disent laquelle des causes
         possibles est en jeu — niveau trop faible, capture arrêtée, réveil
         désactivé, ou fenêtre de nuit — là où l'écran muet ne disait rien. -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Surveillance du son — état en direct"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textRoomSoundStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:textSize="14sp"
        android:text="Connexion au service…" />

    <!-- Ordre d'empilement des trois zones de l'écran de Jean (voir
         HomeZonesController) : le bon ordre dépend de la position de la
         tablette et de la vue de Jean (assis, couché, tablette en hauteur),
         impossible à figer une fois pour toutes.

         Un choix parmi les six ordres possibles plutôt que trois listes
         séparées : aucun réglage incohérent n'est atteignable (deux zones au
         même endroit, une zone nulle part), donc rien à valider ni à
         rattraper. La météo n'a plus de réglage : wttr.in ne demande aucune
         clé API (voir WeatherClient). -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Ordre des zones sur l'écran de Jean"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="De haut en bas. Date/météo, paroles de la pièce, appel."
        android:textSize="14sp" />

    <Spinner
        android:id="@+id/spinnerZoneOrder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <!-- Réveil de l'écran au moindre son de la pièce (voir RoomPresenceService) :
         la tablette n'a pas de capteur de présence dédié, le microphone déjà
         autorisé (RECORD_AUDIO) sert de repli. Sensibilité et durée de
         silence dépendent du microphone et de l'acoustique de la pièce,
         impossibles à régler une fois pour toutes en usine — à ajuster ici
         sur place si besoin. -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Réveil de l'écran au son"
        android:textSize="16sp"
        android:textStyle="bold" />

    <CheckBox
        android:id="@+id/checkboxRoomWakeEnabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Réveiller l'écran au moindre son de la pièce" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Sensibilité (plus petit = plus sensible, ex. 1000)"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/inputRoomWakeThreshold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number" />

</LinearLayout>
</ScrollView>
