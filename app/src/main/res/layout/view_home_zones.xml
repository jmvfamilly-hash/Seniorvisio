<?xml version="1.0" encoding="utf-8"?>
<!--
     Les trois zones de l'écran de Jean, empilées verticalement par-dessus le
     fond (voir HomeZonesController). Inclus tel quel par l'écran d'accueil
     (activity_main) et par l'écran d'appel (activity_incoming_call) : c'est
     le même écran pour Jean, seul le fond change — uni au repos, occupé par
     la galerie de photos choisie par l'administrateur, remplacé par la vidéo
     du proche pendant un appel, puis par ses photos s'il lance un diaporama.

     Les trois occupent chacune exactement un tiers de la hauteur, en
     permanence. Les zones de texte vides sont rendues invisibles et non
     retirées de la mise en page : leur place reste réservée, donc rien ne
     bouge jamais et Jean retrouve toujours chaque chose au même endroit — mais
     on ne voit pas pour autant un cadre semi-opaque vide occuper l'écran.

     L'ordre des enfants ici est l'ordre par défaut (voir HomeZone) ; il est
     réappliqué au démarrage depuis le réglage admin, qui peut le changer —
     d'où la même marge haute sur les trois plutôt que sur les deux dernières :
     celle qui se retrouve en premier ne doit pas coller au bord plus que les
     autres.

     Aucune couleur n'est fixée ici : la palette entière (fond des zones,
     couleurs de texte) est posée en code selon l'heure et la luminosité de la
     pièce (voir ScreenTheme). Les écrire ici donnerait un écran clair le
     temps d'une image au réveil de nuit.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/zoneStack"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Zone 1 : la seule toujours affichée. Date et météo — jamais l'heure
         exacte ni la température (voir TimeContext et WeatherClient). La
         seule heure exacte de cet écran est désormais l'horloge à aiguilles,
         ajoutée à part dans les écrans hôtes — un choix délibéré fait à la
         demande, qui revient sur la règle énoncée ci-dessus pour cette seule
         zone.

         Le moment de la journée et le bouton « Écran noir » ne sont PLUS ici :
         sortis vers chaque écran hôte (voir activity_main.xml et
         activity_incoming_call.xml), posés tout en bas de l'écran plutôt que
         dans ce bandeau — demandé après un essai où « en bas » avait été
         compris comme « en bas du bandeau » plutôt que « en bas de l'écran ».
         Ce même choix libère aussi toute la hauteur de ce bandeau pour la
         seule date et la météo, et donc d'autant plus de place en dessous
         pour l'horloge. -->
    <FrameLayout
        android:id="@+id/zoneInfo"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:padding="16dp">

        <TextView
            android:id="@+id/textClockDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:textSize="46sp"
            android:textStyle="bold"
            android:text="" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textWeatherIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="44sp"
                android:visibility="gone"
                android:text="" />

            <TextView
                android:id="@+id/textWeatherLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:textSize="34sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:text="" />
        </LinearLayout>

        <!-- Ne séparait plus moment et météo une fois le moment sorti d'ici :
             gardé pour le code qui bascule sa visibilité (voir
             HomeZonesController.updateInfoZone), mais sans dimension propre
             pour ne plus rien dessiner. -->
        <TextView
            android:id="@+id/textMomentWeatherSeparator"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="·" />
    </FrameLayout>

    <!-- Zone 2 : tout ce que le microphone de la tablette entend — ce qui se
         dit dans la pièce, auprès de Jean (voir TranscriptionSource.ROOM). -->
    <LinearLayout
        android:id="@+id/zoneRoom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="invisible"
        android:alpha="0">

        <ScrollView
            android:id="@+id/roomCaptionScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <TextView
                android:id="@+id/textRoomCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="@dimen/caption_text_size_default"
                android:text="" />
        </ScrollView>
    </LinearLayout>

    <!-- Zone 3 : tout ce qui ne vient PAS du microphone de la tablette,
         aujourd'hui le son reçu d'un appel (voir TranscriptionSource.CALL).
         Mêmes règles d'affichage que la zone 2, même code (voir
         RollingCaptionZone) : c'est la source, et elle seule, qui décide de
         la zone. -->
    <LinearLayout
        android:id="@+id/zoneCall"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="invisible"
        android:alpha="0">

        <!-- ═══ QUI PARLE, AU-DESSUS DE CE QU'IL DIT ═══

             Masqué partout sauf en mode « Sous-titres » (voir
             IncomingCallActivity) : pendant un appel ordinaire, le visage du
             proche occupe l'écran et répond déjà à la question. En mode
             « Sous-titres » il n'y a ni visage ni sonnerie — du texte
             apparaît par-dessus les photos, et sans cette ligne rien ne dit
             de qui il est.

             GONE et non INVISIBLE : la place qu'il prendrait autrement est
             retirée au texte, qui n'en a jamais trop. -->
        <TextView
            android:id="@+id/textCallCaptionTitre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="22sp"
            android:visibility="gone"
            android:text="" />

        <!-- 0dp + poids, et non match_parent : le titre ci-dessus est
             désormais un frère dans une pile verticale, et un match_parent y
             réclamerait la hauteur ENTIÈRE de la zone en plus de celle du
             titre — les dernières lignes du texte sortiraient par le bas. -->
        <ScrollView
            android:id="@+id/callCaptionScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <TextView
                android:id="@+id/textCallCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="@dimen/caption_text_size_default"
                android:text="" />
        </ScrollView>
    </LinearLayout>


</LinearLayout>
