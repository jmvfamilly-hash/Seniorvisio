<?xml version="1.0" encoding="utf-8"?>
<!--
     Les trois zones de l'écran de Jean, empilées verticalement par-dessus le
     fond (voir HomeZonesController). Inclus tel quel par l'écran d'accueil
     (activity_main) et par l'écran d'appel (activity_incoming_call) : c'est
     le même écran pour Jean, seul le fond change — uni au repos, occupé par
     la galerie de photos choisie par l'administrateur, remplacé par la vidéo
     du proche pendant un appel, puis par ses photos s'il lance un diaporama.

     Les trois occupent chacune exactement un tiers de la hauteur, en
     permanence. Les zones de texte vides sont rendues invisibles et non
     retirées de la mise en page : leur place reste réservée, donc rien ne
     bouge jamais et Jean retrouve toujours chaque chose au même endroit — mais
     on ne voit pas pour autant un cadre semi-opaque vide occuper l'écran.

     L'ordre des enfants ici est l'ordre par défaut (voir HomeZone) ; il est
     réappliqué au démarrage depuis le réglage admin, qui peut le changer —
     d'où la même marge haute sur les trois plutôt que sur les deux dernières :
     celle qui se retrouve en premier ne doit pas coller au bord plus que les
     autres.

     Aucune couleur n'est fixée ici : la palette entière (fond des zones,
     couleurs de texte) est posée en code selon l'heure et la luminosité de la
     pièce (voir ScreenTheme). Les écrire ici donnerait un écran clair le
     temps d'une image au réveil de nuit.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/zoneStack"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Zone 1 : la seule toujours affichée. Date, moment de la journée et
         météo — un pictogramme et un mot pour chacun, jamais l'heure exacte
         ni la température (voir TimeContext et WeatherClient). -->
    <LinearLayout
        android:id="@+id/zoneInfo"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="top"
        android:layout_marginTop="8dp"
        android:padding="16dp">

    <!-- Le bandeau proprement dit, inchangé, mais désormais dans une colonne à
         part : le bouton de sommeil vit à sa droite, et sans cette colonne il
         aurait décentré la date et la météo. Poids 1 pour que le bandeau reste
         centré sur la largeur qui lui reste, quelle que soit celle du bouton. -->
    <!-- wrap_content, ET ON N'Y REVIENT PAS.

         Cette colonne a été en match_parent. Tant que zoneInfo pesait un tiers
         de l'écran cela ne se voyait pas, mais le jour où zoneInfo s'est
         réduite à son contenu, un enfant match_parent dans un parent
         wrap_content n'a plus eu de hauteur définie — chacun attendait la
         mesure de l'autre. La bande se mesurait trop court, la date de 38 sp
         débordait par le bas, et ce qui était dessiné après la recouvrait.

         zoneInfo ne se réduit plus aujourd'hui, mais la dépendance circulaire,
         elle, reviendrait telle quelle. -->
    <LinearLayout
        android:id="@+id/blocInfoCentre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="top|center_horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textMomentIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="48sp"
                android:text="" />

            <TextView
                android:id="@+id/textMomentLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:textSize="30sp"
                android:textStyle="bold"
                android:text="" />

            <TextView
                android:id="@+id/textMomentWeatherSeparator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:textSize="30sp"
                android:visibility="gone"
                android:text="·" />

            <TextView
                android:id="@+id/textWeatherIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:textSize="48sp"
                android:visibility="gone"
                android:text="" />

            <TextView
                android:id="@+id/textWeatherLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:textSize="30sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:text="" />
        </LinearLayout>

        <TextView
            android:id="@+id/textClockDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="38sp"
            android:gravity="center"
            android:text="" />

        <!-- ═══ LA CONSIGNE N'EST PAS POUR JEAN ═══

             Elle s'adresse à qui entre dans la pièce : un proche, une
             aide-soignante, un visiteur. Eux seuls peuvent agir sur ce que
             cette phrase demande, et eux seuls savent lire un écran qu'ils
             découvrent.

             C'est aussi ce qui explique le bouton d'à côté. Un pictogramme,
             même bien choisi, ne dit pas À QUOI IL SERT DANS CETTE
             PIÈCE-CI — « appuyez pour que Jean vous lise » le dit, et en une
             seule phrase.

             Plus petite que la date et sans emphase : la date est le repère
             permanent de Jean, cette phrase est une indication pour quelqu'un
             d'autre. Elle ne doit pas lui passer devant.

             La couleur vient de la palette comme tout le reste (voir
             HomeZonesController.applyPalette), avec une transparence qui la
             met en retrait sans la rendre illisible. -->
        <TextView
            android:id="@+id/texteConsigneSousTitres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="20sp"
            android:alpha="0.75"
            android:gravity="center"
            android:text="Pour que Jean puisse lire vos paroles sur la tablette, appuyez sur Sous-titres" />
    </LinearLayout>

        <!-- ═══ « SOMMEIL » : JEAN ÉTEINT SA DALLE QUAND IL VEUT ═══

             Pas d'interrupteur, pas de bouton physique à trouver derrière la
             tablette : le geste le plus courant de la journée — « je ne veux
             plus de lumière » — n'avait aucune réponse à l'écran.

             Rien d'irréversible : l'écran se rallume au premier appel et à la
             première parole dans la pièce, le réveil au son étant le seul
             chemin de retour (voir DetecteurSon et le seuil réglé par
             l'administrateur). C'est pourquoi le pictogramme est une lune et
             non un symbole d'extinction, qui aurait laissé croire à Jean qu'il
             vient de fermer quelque chose qu'il ne saurait pas rouvrir.

             Aux dimensions des consignes comme les autres — 88 dp de côté,
             relief déclaré, texte sans capitales — mais sans libellé étalé :
             dans le bandeau de la date, une pastille carrée se distingue mieux
             d'un texte qu'un bouton large qui lui ressemblerait. -->
        <Button
            android:id="@+id/boutonSommeil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="88dp"
            android:minHeight="88dp"
            android:text="Sommeil"
            android:textSize="20sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:drawableTop="@drawable/ic_sommeil"
            android:drawablePadding="4dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:elevation="6dp"
            android:background="@drawable/fond_bouton_navigation" />
    </LinearLayout>

    <!-- Zone 2 : tout ce que le microphone de la tablette entend — ce qui se
         dit dans la pièce, auprès de Jean (voir TranscriptionSource.ROOM). -->
    <LinearLayout
        android:id="@+id/zoneRoom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="invisible"
        android:alpha="0">

        <ScrollView
            android:id="@+id/roomCaptionScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <TextView
                android:id="@+id/textRoomCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="@dimen/caption_text_size_default"
                android:text="" />
        </ScrollView>
    </LinearLayout>

    <!-- Zone 3 : tout ce qui ne vient PAS du microphone de la tablette,
         aujourd'hui le son reçu d'un appel (voir TranscriptionSource.CALL).
         Mêmes règles d'affichage que la zone 2, même code (voir
         RollingCaptionZone) : c'est la source, et elle seule, qui décide de
         la zone. -->
    <LinearLayout
        android:id="@+id/zoneCall"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="invisible"
        android:alpha="0">

        <ScrollView
            android:id="@+id/callCaptionScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <TextView
                android:id="@+id/textCallCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="@dimen/caption_text_size_default"
                android:text="" />
        </ScrollView>
    </LinearLayout>


</LinearLayout>
