<?xml version="1.0" encoding="utf-8"?>
<!--
     Les trois zones de l'écran de Jean, empilées verticalement par-dessus le
     fond (voir HomeZonesController). Inclus tel quel par l'écran d'accueil
     (activity_main) et par l'écran d'appel (activity_incoming_call) : c'est
     le même écran pour Jean, seul le fond change — uni hors appel, remplacé
     par la vidéo du proche pendant un appel, puis par ses photos s'il lance
     un diaporama.

     Les trois occupent chacune exactement un tiers de la hauteur, en
     permanence. Les zones de texte vides sont rendues invisibles et non
     retirées de la mise en page : leur place reste réservée, donc rien ne
     bouge jamais et Jean retrouve toujours chaque chose au même endroit — mais
     on ne voit pas pour autant un cadre semi-opaque vide occuper l'écran.

     L'ordre des enfants ici est l'ordre par défaut (voir HomeZone) ; il est
     réappliqué au démarrage depuis le réglage admin, qui peut le changer —
     d'où la même marge haute sur les trois plutôt que sur les deux dernières :
     celle qui se retrouve en premier ne doit pas coller au bord plus que les
     autres.

     Aucune couleur n'est fixée ici : la palette entière (fond des zones,
     couleurs de texte) est posée en code selon l'heure et la luminosité de la
     pièce (voir ScreenTheme). Les écrire ici donnerait un écran clair le
     temps d'une image au réveil de nuit.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/zoneStack"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Zone 1 : la seule toujours affichée. Date, moment de la journée et
         météo — un pictogramme et un mot pour chacun, jamais l'heure exacte
         ni la température (voir TimeContext et WeatherClient). -->
    <LinearLayout
        android:id="@+id/zoneInfo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="top"
        android:layout_marginTop="8dp"
        android:padding="16dp">

    <!-- Le bandeau proprement dit, inchangé, mais désormais dans une colonne à
         part : le bouton de sommeil vit à sa droite, et sans cette colonne il
         aurait décentré la date et la météo. Poids 1 pour que le bandeau reste
         centré sur la largeur qui lui reste, quelle que soit celle du bouton. -->
    <LinearLayout
        android:id="@+id/blocInfoCentre"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="top|center_horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textMomentIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="48sp"
                android:text="" />

            <TextView
                android:id="@+id/textMomentLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:textSize="30sp"
                android:textStyle="bold"
                android:text="" />

            <TextView
                android:id="@+id/textMomentWeatherSeparator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:textSize="30sp"
                android:visibility="gone"
                android:text="·" />

            <TextView
                android:id="@+id/textWeatherIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:textSize="48sp"
                android:visibility="gone"
                android:text="" />

            <TextView
                android:id="@+id/textWeatherLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:textSize="30sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:text="" />
        </LinearLayout>

        <TextView
            android:id="@+id/textClockDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="38sp"
            android:gravity="center"
            android:text="" />
    </LinearLayout>

        <!-- ═══ « SOMMEIL » : JEAN ÉTEINT SA DALLE QUAND IL VEUT ═══

             Pas d'interrupteur, pas de bouton physique à trouver derrière la
             tablette : le geste le plus courant de la journée — « je ne veux
             plus de lumière » — n'avait aucune réponse à l'écran.

             Rien d'irréversible : l'écran se rallume au premier appel, à la
             première parole dans la pièce si le réveil au son est actif, et au
             prochain titre d'actualité. C'est pourquoi le pictogramme est une
             lune et non un symbole d'extinction, qui aurait laissé croire à
             Jean qu'il vient de fermer quelque chose qu'il ne saurait pas
             rouvrir.

             Aux dimensions des consignes comme les autres — 88 dp de côté,
             relief déclaré, texte sans capitales — mais sans libellé étalé :
             dans le bandeau de la date, une pastille carrée se distingue mieux
             d'un texte qu'un bouton large qui lui ressemblerait. -->
        <Button
            android:id="@+id/boutonSommeil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="88dp"
            android:minHeight="88dp"
            android:text="Sommeil"
            android:textSize="20sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:drawableTop="@drawable/ic_sommeil"
            android:drawablePadding="4dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:elevation="6dp"
            android:background="@drawable/fond_bouton_navigation" />
    </LinearLayout>

    <!-- Zone 2 : tout ce que le microphone de la tablette entend — ce qui se
         dit dans la pièce, auprès de Jean (voir TranscriptionSource.ROOM). -->
    <LinearLayout
        android:id="@+id/zoneRoom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="invisible"
        android:alpha="0">

        <ScrollView
            android:id="@+id/roomCaptionScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <TextView
                android:id="@+id/textRoomCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="@dimen/caption_text_size_default"
                android:text="" />
        </ScrollView>
    </LinearLayout>

    <!-- Zone 3 : tout ce qui ne vient PAS du microphone de la tablette,
         aujourd'hui le son reçu d'un appel (voir TranscriptionSource.CALL).
         Mêmes règles d'affichage que la zone 2, même code (voir
         RollingCaptionZone) : c'est la source, et elle seule, qui décide de
         la zone. -->
    <LinearLayout
        android:id="@+id/zoneCall"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="invisible"
        android:alpha="0">

        <ScrollView
            android:id="@+id/callCaptionScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <TextView
                android:id="@+id/textCallCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="@dimen/caption_text_size_default"
                android:text="" />
        </ScrollView>
    </LinearLayout>


    <!-- ═══ L'ACTUALITÉ : ELLE PREND LES DEUX ZONES DU BAS ═══

         Poids 2, soit exactement la place de zoneRoom et zoneCall réunies :
         elle ne s'ajoute pas à la pile, elle s'y substitue (voir
         HomeZonesController.modeActualite). L'écran de Jean garde donc
         seulement deux surfaces — le bandeau de la date, et le titre.

         Cette hauteur double n'est pas un confort : un titre de fil
         d'information fait 156 signes en moyenne sur ce flux, et la vignette
         qui l'accompagne est en 16/9. Dans une seule bande, l'image aurait
         été réduite à un timbre-poste.

         autoSizeTextType uniform : le texte rétrécit jusqu'à tenir plutôt que
         d'être tronqué. Plancher à 22 sp — en dessous, plus personne ne lit
         cet écran depuis un fauteuil. -->
    <LinearLayout
        android:id="@+id/zoneActualite"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="vertical"
        android:baselineAligned="false"
        android:padding="20dp"
        android:visibility="gone">

    <!-- La rangée image + texte, qui prend toute la place restante une fois
         la barre de navigation servie. Elle garde exactement la mise en page
         d'avant : c'est le conteneur au-dessus qui est devenu vertical. -->
    <LinearLayout
        android:id="@+id/rangeeActualite"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- ═══ LA PHOTO ET SON CRÉDIT, DANS UNE SEULE COLONNE ═══

             L'ImageView occupait cette place seule. Le crédit du photographe
             se rapporte à l'image et non à l'article : il descend donc avec
             elle, et non sous le titre où il passerait pour le nom du fil.

             La photo prend le POIDS, le crédit son contenu. La photo se réduit
             donc exactement de la hauteur du crédit, et la colonne entière
             reste dans la hauteur de la rangée — celle du bloc de titre en
             face. Sans cela, la ligne ajoutée pousserait la colonne au-delà et
             le bas de la photo serait coupé.

             fitCenter et non centerCrop : une photo de presse recadrée perd
             souvent son sujet, et personne ne peut le signaler ici. -->
        <LinearLayout
            android:id="@+id/colonneImageAccueil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:layout_marginEnd="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imageActualiteAccueil"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="Illustration de l'article" />

            <TextView
                android:id="@+id/creditActualiteAccueil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp"
                android:alpha="0.55"
                android:gravity="end"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone"
                android:text="" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="6"
            android:orientation="vertical">

            <TextView
                android:id="@+id/texteActualiteAccueil"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="22sp"
                android:autoSizeMaxTextSize="64sp"
                android:autoSizeStepGranularity="2sp" />

            <!-- ═══ D'OÙ SORT CETTE NOUVELLE ═══

                 Le fil se nomme lui-même dans <channel><title>. Depuis que
                 plusieurs fils cohabitent, c'est une question qu'on se pose en
                 lisant un titre, et à laquelle rien ne répondait.

                 Discrètement, et le mot est à prendre au sérieux : c'est le
                 TITRE que Jean doit lire. Petit corps, transparence réduite,
                 sous le texte. Masqué quand le fil ne se nomme pas, plutôt
                 qu'une mention vide ou un « source inconnue » qui prendrait de
                 la place pour ne rien dire. -->
            <TextView
                android:id="@+id/origineActualiteAccueil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="16sp"
                android:alpha="0.55"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone"
                android:text="" />
        </LinearLayout>
    </LinearLayout>

        <!-- ═══ JEAN PEUT AVANCER DANS LES TITRES ═══

             Le fil défile tout seul au rythme de la journée (voir
             CadenceurActualites) : Jean n'a rien à faire, et ces boutons ne
             changent rien à ça. Ils lui donnent seulement de quoi revenir sur
             un titre entrevu, ou passer celui qui ne l'intéresse pas.

             Un choix fait à la main tient jusqu'au prochain créneau, puis le
             fil reprend sa route (voir MainActivity). Rien à annuler, rien à
             refermer : l'écran se remet d'aplomb tout seul, ce qui est la
             seule façon acceptable qu'une manipulation se termine ici.

             L'espaceur central garantit le vide entre les deux cibles, quelles
             que soient la police et la longueur des libellés. -->
        <LinearLayout
            android:id="@+id/barreNavigationActualite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/boutonActualitePrecedente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Précédent"
                android:textSize="24sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:drawableStart="@drawable/ic_precedent"
                android:drawablePadding="16dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:minHeight="88dp"
                android:minWidth="240dp"
                android:elevation="6dp"
                android:background="@drawable/fond_bouton_navigation" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:minWidth="24dp" />

            <Button
                android:id="@+id/boutonActualiteSuivante"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Suivant"
                android:textSize="24sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:drawableEnd="@drawable/ic_suivant"
                android:drawablePadding="16dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:minHeight="88dp"
                android:minWidth="240dp"
                android:elevation="6dp"
                android:background="@drawable/fond_bouton_navigation" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
