<?xml version="1.0" encoding="utf-8"?>
<!--
     Les trois zones de l'écran de Jean, empilées verticalement par-dessus le
     fond (voir HomeZonesController). Inclus tel quel par l'écran d'accueil
     (activity_main) et par l'écran d'appel (activity_incoming_call) : c'est
     le même écran pour Jean, seul le fond change — uni au repos, occupé par
     la galerie de photos choisie par l'administrateur, remplacé par la vidéo
     du proche pendant un appel, puis par ses photos s'il lance un diaporama.

     Les trois occupent chacune exactement un tiers de la hauteur, en
     permanence. Les zones de texte vides sont rendues invisibles et non
     retirées de la mise en page : leur place reste réservée, donc rien ne
     bouge jamais et Jean retrouve toujours chaque chose au même endroit — mais
     on ne voit pas pour autant un cadre semi-opaque vide occuper l'écran.

     L'ordre des enfants ici est l'ordre par défaut (voir HomeZone) ; il est
     réappliqué au démarrage depuis le réglage admin, qui peut le changer —
     d'où la même marge haute sur les trois plutôt que sur les deux dernières :
     celle qui se retrouve en premier ne doit pas coller au bord plus que les
     autres.

     Aucune couleur n'est fixée ici : la palette entière (fond des zones,
     couleurs de texte) est posée en code selon l'heure et la luminosité de la
     pièce (voir ScreenTheme). Les écrire ici donnerait un écran clair le
     temps d'une image au réveil de nuit.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/zoneStack"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Zone 1 : la seule toujours affichée. Date et météo — jamais l'heure
         exacte ni la température (voir TimeContext et WeatherClient). La
         seule heure exacte de cet écran est désormais l'horloge à aiguilles,
         ajoutée à part dans les écrans hôtes — un choix délibéré fait à la
         demande, qui revient sur la règle énoncée ci-dessus pour cette seule
         zone.

         Le moment de la journée et le bouton « Écran noir » ne sont PLUS ici :
         sortis vers chaque écran hôte (voir activity_main.xml et
         activity_incoming_call.xml), posés tout en bas de l'écran plutôt que
         dans ce bandeau — demandé après un essai où « en bas » avait été
         compris comme « en bas du bandeau » plutôt que « en bas de l'écran ».
         Ce même choix libère aussi toute la hauteur de ce bandeau pour la
         seule date et la météo, et donc d'autant plus de place en dessous
         pour l'horloge. -->
    <FrameLayout
        android:id="@+id/zoneInfo"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:padding="16dp">

        <TextView
            android:id="@+id/textClockDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:textSize="46sp"
            android:textStyle="bold"
            android:text="" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textWeatherIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="44sp"
                android:visibility="gone"
                android:text="" />

            <TextView
                android:id="@+id/textWeatherLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:textSize="34sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:text="" />
        </LinearLayout>

        <!-- Ne séparait plus moment et météo une fois le moment sorti d'ici :
             gardé pour le code qui bascule sa visibilité (voir
             HomeZonesController.updateInfoZone), mais sans dimension propre
             pour ne plus rien dessiner. -->
        <TextView
            android:id="@+id/textMomentWeatherSeparator"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="·" />
    </FrameLayout>

    <!-- Zone 2 : tout ce que le microphone de la tablette entend — ce qui se
         dit dans la pièce, auprès de Jean (voir TranscriptionSource.ROOM). -->
    <LinearLayout
        android:id="@+id/zoneRoom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="invisible"
        android:alpha="0">

        <!-- fillViewport, et la TextView en match_parent : un texte court
             (p. ex. un mot public de deux lignes, voir
             RollingCaptionZone.afficherTexteFixe) se centre alors
             verticalement dans tout le bandeau au lieu de s'accrocher en
             haut avec du vide gris en dessous — constaté en usage réel.
             android:gravity="center" sur la TextView centre déjà le texte
             DANS ses propres limites ; sans ces deux réglages, ces limites
             ne faisaient que la hauteur du texte lui-même. Un texte plus
             long qu'un bandeau continue de défiler normalement :
             fillViewport n'agit que quand le contenu est plus PETIT que la
             zone. -->
        <ScrollView
            android:id="@+id/roomCaptionScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:scrollbars="none"
            android:fillViewport="true">

            <TextView
                android:id="@+id/textRoomCaption"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="@dimen/caption_text_size_default"
                android:text="" />
        </ScrollView>
    </LinearLayout>

    <!-- Zone 3 : tout ce qui ne vient PAS du microphone de la tablette,
         aujourd'hui le son reçu d'un appel (voir TranscriptionSource.CALL).
         Mêmes règles d'affichage que la zone 2, même code (voir
         RollingCaptionZone) : c'est la source, et elle seule, qui décide de
         la zone. -->
    <LinearLayout
        android:id="@+id/zoneCall"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="invisible"
        android:alpha="0">

        <!-- ═══ EN DIRECT OU ENREGISTRÉ, ET SON TEXTE, SUR LA MÊME LIGNE ═══

             Cette zone affiche trois choses de nature différente — un appel
             réel, un message du répondeur, un mot public — et rien dans la
             mise en page ne les distingue jusqu'ici que le bandeau/la
             mention jaune qu'on doit LIRE. Pour quelqu'un qui ne lit pas
             facilement, un repère qui ne demande aucune lecture compte
             davantage : un voyant qui respire doucement (en direct, voir
             fond_voyant_direct) ou une enveloppe (enregistré, voir
             ic_message_enregistre), toujours au même endroit, jamais les
             deux ensemble.

             textCallEnLigne (la mention jaune, « [Nom] n'est pas en ligne »
             ou, plus tard, « [Nom] est en ligne ») vit ICI, à côté de
             l'icône qui l'annonce — et non plus sur sa propre ligne sous le
             texte qui défile : les deux ont un temps disputé la même place
             qu'un texte assez long, et la zone qui défile en a maintenant
             TOUTE la hauteur restante, sans plus rien à partager avec elle.

             Posée en haut de la zone, donc AVANT le reste — premier enfant
             de cette pile verticale. match_parent et non wrap_content,
             désormais : la mention peut être longue, et doit pouvoir
             occuper toute la largeur qui reste après l'icône. -->
        <LinearLayout
            android:id="@+id/zoneCallIndicateur"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/voyantEnDirect"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/fond_voyant_direct"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/iconeMessageEnregistre"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_message_enregistre"
                android:contentDescription="Message enregistré"
                android:visibility="gone" />

            <!-- GONE par défaut, et non INVISIBLE : sans texte, elle ne
                 doit réclamer aucune place sur cette ligne. 0dp + poids
                 pour profiter de toute la largeur qui reste après l'icône,
                 plutôt que de la faire déborder sur plusieurs lignes au
                 milieu de la ligne d'icône. -->
            <TextView
                android:id="@+id/textCallEnLigne"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:textStyle="bold"
                android:textColor="#FDE68A"
                android:textSize="20sp"
                android:visibility="gone"
                android:text="" />
        </LinearLayout>

        <!-- ═══ QUI PARLE, AU-DESSUS DE CE QU'IL DIT ═══

             Masqué partout sauf en mode « Sous-titres » (voir
             IncomingCallActivity) : pendant un appel ordinaire, le visage du
             proche occupe l'écran et répond déjà à la question. En mode
             « Sous-titres » il n'y a ni visage ni sonnerie — du texte
             apparaît par-dessus les photos, et sans cette ligne rien ne dit
             de qui il est.

             GONE et non INVISIBLE : la place qu'il prendrait autrement est
             retirée au texte, qui n'en a jamais trop. -->
        <TextView
            android:id="@+id/textCallCaptionTitre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="22sp"
            android:visibility="gone"
            android:text="" />

        <!-- 0dp + poids, et non match_parent : le titre ci-dessus est
             désormais un frère dans une pile verticale, et un match_parent y
             réclamerait la hauteur ENTIÈRE de la zone en plus de celle du
             titre — les dernières lignes du texte sortiraient par le bas. -->
        <!-- fillViewport, et la TextView en match_parent : voir la même
             remarque sur roomCaptionScroll — un texte plus court que le
             bandeau (le cas courant du mot public) se centre verticalement
             au lieu de s'accrocher en haut avec du vide gris en dessous,
             constaté en usage réel. N'empêche pas un texte plus long de
             défiler normalement : fillViewport n'agit que si le contenu
             est plus PETIT que la zone. -->
        <ScrollView
            android:id="@+id/callCaptionScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="16dp"
            android:scrollbars="none"
            android:fillViewport="true">

            <TextView
                android:id="@+id/textCallCaption"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="@dimen/caption_text_size_default"
                android:text="" />
        </ScrollView>
    </LinearLayout>


</LinearLayout>
